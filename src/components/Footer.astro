    <div class="divider" style="margin: 1.5rem auto;"></div>
    <div class="footer-contacts gsap-fade">
      <div class="contact-item">
        <span class="contact-label">Isabel</span>
        <a href="tel:+34658350693">658 35 06 93</a>
      </div>
      <div class="contact-sep">·</div>
      <div class="contact-item">
        <span class="contact-label">Marcos</span>
        <a href="tel:+34675474544">675 47 45 44</a>
      </div>
    </div>

    <button class="lock-btn gsap-fade" id="lock-btn" aria-label="Acceso privado novios">
      <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
