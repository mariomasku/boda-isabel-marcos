---
import { CATEGORIES } from '../lib/plannerConfig';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const organizacion = CATEGORIES.filter(c => c.group === 'organizacion');
const proveedores  = CATEGORIES.filter(c => c.group === 'proveedores');
---

<button type="button" class="admin-nav-toggle" id="admin-nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="admin-nav-overlay">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <line x1="2" y1="5" x2="18" y2="5"/>
    <line x1="2" y1="10" x2="18" y2="10"/>
    <line x1="2" y1="15" x2="18" y2="15"/>
  </svg>
</button>

<div class="admin-nav-overlay" id="admin-nav-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <nav class="admin-nav-panel" aria-label="Menú de navegación del gestor">
    <div class="admin-nav-panel-header">
      <span class="admin-nav-panel-title">Gestor de boda</span>
      <button type="button" class="admin-nav-close" id="admin-nav-close" aria-label="Cerrar menú">
        <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="1" y1="1" x2="11" y2="11"/><line x1="11" y1="1" x2="1" y2="11"/></svg>
      </button>
    </div>

    <div class="admin-nav-links">
      <a href="/dashboard" class:list={['admin-nav-link', { active: current === 'dashboard' }]}>Resumen</a>
      <a href="/mesas" class:list={['admin-nav-link', { active: current === 'mesas' }]}>Distribución de mesas</a>
      <a href="/presupuesto" class:list={['admin-nav-link', { active: current === 'presupuesto' }]}>Presupuesto</a>

      <p class="admin-nav-group-label">Organización</p>
      {organizacion.map(cat => (
        <a href={`/planner/${cat.id}`} class:list={['admin-nav-link', { active: current === cat.id }]}>{cat.label}</a>
      ))}

      <p class="admin-nav-group-label">Proveedores</p>
      {proveedores.map(cat => (
        <a href={`/planner/${cat.id}`} class:list={['admin-nav-link', { active: current === cat.id }]}>{cat.label}</a>
      ))}
    </div>
  </nav>
</div>

<style>
  .admin-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid color-mix(in srgb, var(--oro) 35%, transparent);
    background: transparent;
    color: var(--oro);
    border-radius: 5px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .admin-nav-toggle:hover { background: color-mix(in srgb, var(--oro) 12%, transparent); }

  .admin-nav-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--eucalipto-noche) 55%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    display: flex;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .admin-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .admin-nav-panel {
    width: min(300px, 84vw);
    height: 100%;
    background: var(--marfil);
    box-shadow: 4px 0 24px color-mix(in srgb, var(--sombra) 25%, transparent);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }
  .admin-nav-overlay.open .admin-nav-panel { transform: translateX(0); }

  .admin-nav-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background: var(--eucalipto);
    border-bottom: 2px solid var(--oro);
  }
  .admin-nav-panel-title {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--oro);
  }
  .admin-nav-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: color-mix(in srgb, var(--oro) 70%, transparent);
    padding: 0.25rem;
    line-height: 1;
    transition: color 0.15s;
  }
  .admin-nav-close:hover { color: var(--oro); }

  .admin-nav-links {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0 1.5rem;
  }
  .admin-nav-group-label {
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--salvia);
    font-weight: 700;
    padding: 1rem 1.25rem 0.4rem;
  }
  .admin-nav-link {
    padding: 0.6rem 1.25rem;
    color: var(--eucalipto);
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    border-left: 3px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }
  .admin-nav-link:hover { background: color-mix(in srgb, var(--oro) 8%, transparent); }
  .admin-nav-link.active {
    border-left-color: var(--oro);
    background: color-mix(in srgb, var(--oro) 12%, transparent);
    font-weight: 700;
  }
</style>

<script>
  const toggle  = document.getElementById('admin-nav-toggle');
  const overlay = document.getElementById('admin-nav-overlay') as HTMLElement;
  const closeBtn = document.getElementById('admin-nav-close');

  function openNav() {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeNav() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openNav);
  closeBtn?.addEventListener('click', closeNav);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeNav(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay.classList.contains('open')) closeNav(); });
</script>
