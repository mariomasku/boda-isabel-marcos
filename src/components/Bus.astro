---
---
<section id="autobus" class="bus-section">
  <div class="bus-container">
    <p class="section-subtitle bus-subtitle gsap-fade">para los de Puente Genil</p>
    <h2 class="section-title bus-title gsap-fade">Autobús</h2>
    <div class="ornament gsap-fade">
      <span class="bus-ornament-star">✦</span>
    </div>

    <p class="bus-intro gsap-fade">
      Ponemos a vuestra disposición un autobús para los invitados de Puente Genil.
      Podéis indicar si lo necesitáis en el formulario de confirmación.
    </p>

    <div class="bus-routes">
      <div class="bus-card bus-card-ida">
        <div class="bus-direction">IDA</div>
        <div class="bus-route">Puente Genil → Cortijo El Alamillo</div>
        <div class="bus-direction">SALIDA DESDE EL LIDL</div>
        <div class="bus-time">17:15h</div>
      </div>

      <div class="bus-arrow" aria-hidden="true">⇄</div>

      <div class="bus-card bus-card-vuelta">
        <div class="bus-direction">VUELTA</div>
        <div class="bus-route">Córdoba → Puente Genil</div>
        <div class="bus-times-list">
          <span>03:00h</span>
          <span class="separator">·</span>
          <span>06:00h</span>
        </div>
      </div>
    </div>

    <p class="bus-note gsap-fade">
      Hay dos opciones de vuelta para que podáis elegir la que mejor os venga.
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Tarjeta IDA: entra desde la izquierda
  gsap.fromTo('.bus-card-ida',
    { opacity: 0, x: -50 },
    {
      opacity: 1,
      x: 0,
      duration: 0.7,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.bus-routes',
        start: 'top 82%',
        toggleActions: 'play none none reverse',
      },
    }
  );

  // Tarjeta VUELTA: entra desde la derecha con ligero retardo
  gsap.fromTo('.bus-card-vuelta',
    { opacity: 0, x: 50 },
    {
      opacity: 1,
      x: 0,
      duration: 0.7,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.bus-routes',
        start: 'top 82%',
        toggleActions: 'play none none reverse',
      },
    }
  );
</script>

<style>
  .bus-section {
    padding: 6rem 1.5rem;
    background: linear-gradient(135deg, #5C3D12 0%, #7A5520 50%, #624015 100%);
    position: relative;
    overflow: hidden;
  }

  /* Patrón de fondo sutil */
  .bus-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23F9F5EF' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .bus-container {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  /* Sobreescribir colores globales de título/subtítulo */
  .bus-subtitle { color: rgba(249,245,239,0.6); }
  .bus-title    { color: #F9F5EF; }
  .bus-ornament-star { color: rgba(249,245,239,0.5); font-size: 1.2rem; }

  /* Icono de bus decorativo */
  .bus-icon {
    width: 172px;
    height: 172px;
    filter: brightness(0) invert(1) opacity(0.55);
  }

  .bus-intro {
    color: rgba(249,245,239,0.75);
    font-family: 'Lato', sans-serif;
    font-size: 0.95rem;
    text-align: center;
    line-height: 1.8;
    max-width: 480px;
    margin-top: 0.25rem;
  }

  /* ── Tarjetas ── */
  .bus-routes {
    display: flex;
    align-items: stretch;
    gap: 1.5rem;
    margin: 2rem 0 1rem;
    width: 100%;
    max-width: 580px;
    justify-content: center;
  }

  .bus-card {
    flex: 1;
    background: rgba(249,245,239,0.07);
    border: 1px solid rgba(249,245,239,0.18);
    padding: 2rem 1.8rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: background 0.25s;
  }

  .bus-card:hover {
    background: rgba(249,245,239,0.11);
  }

  .bus-direction {
    font-family: 'Lato', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.38em;
    color: rgba(249,245,239,0.55);
    font-weight: 700;
  }

  .bus-route {
    font-family: 'Playfair Display', serif;
    font-size: 0.98rem;
    color: rgba(249,245,239,0.88);
    line-height: 1.4;
  }

  .bus-time,
  .bus-times-list {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: #F9F5EF;
    font-weight: 400;
    margin-top: 0.3rem;
    font-style: italic;
  }

  .bus-times-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 1.6rem;
  }

  .separator { color: rgba(249,245,239,0.3); }

  .bus-arrow {
    font-size: 1.6rem;
    color: rgba(249,245,239,0.25);
    align-self: center;
    flex-shrink: 0;
  }

  .bus-note {
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    color: rgba(249,245,239,0.45);
    text-align: center;
    font-style: italic;
  }

  @media (max-width: 580px) {
    .bus-routes {
      flex-direction: column;
      align-items: stretch;
    }
    .bus-arrow { display: none; }
    .bus-card  { width: 100%; }
  }
</style>
