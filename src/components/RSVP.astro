---
---
<section id="rsvp" class="rsvp-section">
  <div class="rsvp-container">
    <p class="section-subtitle gsap-fade">confirma tu asistencia</p>
    <h2 class="section-title gsap-fade">RSVP</h2>
    <div class="ornament gsap-fade">
      <span style="color: var(--gold); font-size:1.2rem;">✦</span>
    </div>
    <p class="rsvp-intro gsap-fade">
      Por favor, confirma tu asistencia antes del <strong>1 de septiembre de 2026</strong>.
      <br>Si no vienes, también te agradeceremos que nos lo indiques.
    </p>

    <form
      id="rsvp-form"
      class="rsvp-form gsap-fade"
      method="POST"
    >
      <!-- 1. Nombre -->
      <div class="form-group">
        <label for="nombre">1. Nombre completo y apellidos *</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre completo" />
      </div>

      <!-- 2. Asistencia -->
      <div class="form-group">
        <label>2. ¿Asistirás a nuestra boda? *</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="asistencia" value="Sí, ¡allí estaré!" required />
            <span>Sí, ¡allí estaré!</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="asistencia" value="No, me lo perderé con todo el dolor de mi corazón" />
            <span>No, me lo perderé con todo el dolor de mi corazón</span>
          </label>
        </div>
      </div>

      <!-- Preguntas adicionales: solo si asistencia = Sí -->
      <div id="extras-si" class="extras-si">

      <!-- 3. Acompañante -->
      <div class="form-group">
        <label>3. ¿Vienes con acompañante?</label>
        <div class="radio-group" id="acompanante-radios">
          <label class="radio-option">
            <input type="radio" name="acompanante" value="si" id="acomp-si" />
            <span>Sí</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="acompanante" value="no" id="acomp-no" />
            <span>No</span>
          </label>
        </div>
        <div class="conditional" id="acomp-nombre-block" style="display:none">
          <input type="text" id="acompanante_nombre" name="acompanante_nombre" placeholder="Nombre completo de tu acompañante" />
        </div>
      </div>

      <!-- 4. Niños -->
      <div class="form-group">
        <label>4. ¿Traes niños?</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="ninos" value="si" id="ninos-si" />
            <span>Sí</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="ninos" value="no" id="ninos-no" />
            <span>No</span>
          </label>
        </div>
      </div>

      <!-- 5. Datos niños (dinámico) -->
      <div id="ninos-block" style="display:none" class="ninos-wrapper">
        <div class="form-group">
          <label for="ninos_count">5. ¿Cuántos niños traes?</label>
          <select id="ninos_count" name="ninos_count">
            <option value="">Selecciona...</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
          </select>
        </div>
        <div id="ninos-names-container"></div>
      </div>

      <!-- 6. Alergias -->
      <div class="form-group">
        <label for="alergias">6. ¿Alguien en tu grupo tiene alguna alergia, intolerancia o dieta especial?</label>
        <p class="form-hint">Vegano, vegetariano, embarazada, celíaco... Por favor, especifica quién y qué restricción.</p>
        <textarea id="alergias" name="alergias" rows="3" placeholder="Ej: María — vegetariana. Sin restricciones para el resto."></textarea>
      </div>

      <!-- 7. Bebida -->
      <div class="form-group">
        <label>7. ¿Qué tipo de bebida alcohólica consumes?</label>
        <div class="checkbox-group">
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Whisky" />
            <span>Whisky</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Ginebra" />
            <span>Ginebra</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Ron" />
            <span>Ron</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Vodka" />
            <span>Vodka</span>
          </label>
        </div>
      </div>

      <!-- 8. Autobús -->
      <div class="form-group">
        <label>8. Para los de Puente Genil: ¿necesitarás el autobús?</label>
        <div class="radio-group" id="bus-radios">
          <label class="radio-option">
            <input type="radio" name="autobus" value="Ida y vuelta" id="bus-idavuelta" />
            <span>Sí, ida y vuelta</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="Solo ida" />
            <span>Solo ida</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="Solo vuelta" />
            <span>Solo vuelta</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="No lo necesitaré" id="bus-no" />
            <span>No lo necesitaré</span>
          </label>
        </div>
      </div>

      <!-- 9. Plazas autobús -->
      <div class="form-group conditional" id="bus-plazas-block" style="display:none">
        <label for="bus_plazas">9. ¿Cuántas plazas necesitarías?</label>
        <select id="bus_plazas" name="bus_plazas">
          <option value="">Selecciona...</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
          <option value="6">6</option>
          <option value="7">7</option>
          <option value="8">8</option>
          <option value="9">9</option>
        </select>
      </div>

      <!-- 10. Canción -->
      <div class="form-group">
        <label for="cancion">10. ¿Qué canción no puede faltar en la pista de baile?</label>
        <input type="text" id="cancion" name="cancion" placeholder="¡Esa que hace que lo des todo!" />
      </div>

      <!-- 11. Comentarios -->
      <div class="form-group">
        <label for="comentarios">11. ¿Tienes alguna otra duda o comentario?</label>
        <textarea id="comentarios" name="comentarios" rows="4" placeholder="Cuéntanos..."></textarea>
        <div class="photo-hint">
          <img src="/icons/fotos.svg" alt="" aria-hidden="true" class="photo-hint-icon" />
          <p class="photo-hint-text">Si tienes pensado hacernos una sorpresa durante la cena, por favor, ponte en contacto con nuestro fotógrafo para que pueda captar ese momento tan especial.</p>
          <div class="photo-hint-contact">
            <strong class="photo-hint-name">Rafael Badia</strong>
            <a href="tel:+34637352642" class="photo-hint-tel">637 35 26 42</a>
          </div>
        </div>
      </div>

      </div><!-- /#extras-si -->

      <button type="submit" class="submit-btn">Enviar confirmación</button>

      <div id="form-success" class="form-message success" style="display:none">
        ¡Gracias! Hemos recibido tu confirmación. ¡Nos vemos el 3 de octubre! 🎉
      </div>
      <div id="form-error" class="form-message error" style="display:none">
        Algo ha ido mal. Por favor, inténtalo de nuevo o escríbenos directamente.
      </div>
    </form>
  </div>
</section>

<style>
  .rsvp-section {
    padding: 6rem 1.5rem;
    background: var(--cream);
  }

  .rsvp-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .rsvp-intro {
    text-align: center;
    color: var(--brown-light);
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .rsvp-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .form-group > label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--brown);
    font-weight: 400;
  }

  .form-hint {
    font-size: 0.82rem;
    color: var(--brown-light);
    font-style: italic;
    line-height: 1.6;
  }

  .photo-hint {
    margin-top: 0.8rem;
    padding: 1.8rem 1.5rem;
    background: rgba(196,168,130,0.12);
    border: 1px solid rgba(196,168,130,0.28);
    border-top: 3px solid var(--gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .photo-hint-icon {
    width: 48px;
    height: 48px;
    filter: brightness(0) sepia(1) saturate(0.5) brightness(0.65);
    opacity: 0.8;
  }

  .photo-hint-text {
    font-family: 'Lato', sans-serif;
    font-size: 0.95rem;
    color: var(--brown-light);
    line-height: 1.8;
    font-style: italic;
  }

  .photo-hint-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(196,168,130,0.3);
    width: 100%;
  }

  .photo-hint-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    color: var(--brown);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .photo-hint-tel {
    display: inline-block;
    padding: 0.65rem 2rem;
    border: 1px solid var(--gold);
    color: var(--gold-dark);
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    transition: background 0.2s, color 0.2s;
  }

  .photo-hint-tel:hover {
    background: var(--gold);
    color: white;
  }

  input[type="text"],
  input[type="email"],
  textarea,
  select {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--ivory);
    border: 1px solid rgba(196,168,130,0.5);
    border-radius: 0;
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
  }

  input[type="text"]:focus,
  textarea:focus,
  select:focus {
    border-color: var(--gold);
  }

  textarea { resize: vertical; }

  .radio-group,
  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-option,
  .checkbox-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    padding: 0.7rem 1rem;
    background: var(--ivory);
    border: 1px solid rgba(196,168,130,0.3);
    transition: border-color 0.2s, background 0.2s;
    font-size: 0.9rem;
    color: var(--text);
  }

  .radio-option:hover,
  .checkbox-option:hover {
    border-color: var(--gold);
    background: rgba(196,168,130,0.08);
  }

  .radio-option input,
  .checkbox-option input {
    accent-color: var(--gold-dark);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .conditional {
    margin-top: 0.5rem;
  }

  .submit-btn {
    align-self: center;
    padding: 1rem 3rem;
    background: var(--brown);
    color: #F9F5EF;
    border: none;
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
    margin-top: 1rem;
  }

  .submit-btn:hover {
    background: var(--gold-dark);
    transform: translateY(-2px);
  }

  /* ── Extras condicionales (solo si asistirá) ── */
  .extras-si {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      max-height 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.45s ease;
  }

  .extras-si.visible {
    max-height: 9000px;
    opacity: 1;
    pointer-events: auto;
  }

  .ninos-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.2rem;
    background: rgba(196,168,130,0.08);
    border-left: 2px solid var(--gold);
  }

  #ninos-names-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nino-entry label {
    font-family: 'Playfair Display', serif;
    font-size: 0.95rem;
    color: var(--brown-light);
  }

  .nino-fields {
    display: flex;
    gap: 0.6rem;
  }

  .nino-fields input {
    padding: 0.9rem 1rem;
    background: var(--ivory);
    border: 1px solid rgba(196,168,130,0.5);
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    color: var(--text);
    outline: none;
  }

  .nino-fields input:focus {
    border-color: var(--gold);
  }

  .form-message {
    text-align: center;
    padding: 1rem;
    font-size: 0.9rem;
    border-radius: 0;
  }

  .form-message.success {
    background: rgba(196,168,130,0.2);
    border: 1px solid var(--gold);
    color: var(--brown);
  }

  .form-message.error {
    background: rgba(180,60,60,0.1);
    border: 1px solid #B44;
    color: #922;
  }
</style>

<script>
  // Mostrar/ocultar extras según asistencia
  const extrasSi = document.getElementById('extras-si')!;
  document.querySelectorAll<HTMLInputElement>('input[name="asistencia"]').forEach((el) => {
    el.addEventListener('change', () => {
      const asiste = el.value.startsWith('Sí');
      extrasSi.classList.toggle('visible', asiste);

      if (!asiste) {
        // Limpiar condicionales hijos al ocultar
        (document.getElementById('acomp-nombre-block') as HTMLElement).style.display = 'none';
        (document.getElementById('ninos-block') as HTMLElement).style.display = 'none';
        (document.getElementById('ninos_count') as HTMLSelectElement).value = '';
        (document.getElementById('ninos-names-container') as HTMLElement).innerHTML = '';
        (document.getElementById('bus-plazas-block') as HTMLElement).style.display = 'none';
        document.querySelectorAll<HTMLInputElement>('#extras-si input[type="radio"], #extras-si input[type="checkbox"]')
          .forEach(i => { i.checked = false; });
      }
    });
  });

  // Toggle acompañante nombre
  const acSi = document.getElementById('acomp-si') as HTMLInputElement;
  const acNo = document.getElementById('acomp-no') as HTMLInputElement;
  const acBlock = document.getElementById('acomp-nombre-block')!;

  acSi?.addEventListener('change', () => { acBlock.style.display = 'block'; });
  acNo?.addEventListener('change', () => { acBlock.style.display = 'none'; });

  // Toggle niños block
  const ninosSi = document.getElementById('ninos-si') as HTMLInputElement;
  const ninosNo = document.getElementById('ninos-no') as HTMLInputElement;
  const ninosBlock = document.getElementById('ninos-block')!;

  ninosSi?.addEventListener('change', () => { ninosBlock.style.display = 'flex'; });
  ninosNo?.addEventListener('change', () => {
    ninosBlock.style.display = 'none';
    (document.getElementById('ninos_count') as HTMLSelectElement).value = '';
    document.getElementById('ninos-names-container')!.innerHTML = '';
  });

  // Campos dinámicos por número de niños
  document.getElementById('ninos_count')?.addEventListener('change', (e) => {
    const count = parseInt((e.target as HTMLSelectElement).value) || 0;
    const container = document.getElementById('ninos-names-container')!;
    container.innerHTML = '';

    for (let i = 1; i <= count; i++) {
      const group = document.createElement('div');
      group.className = 'form-group nino-entry';
      group.innerHTML = `
        <label>Niño/a ${i}</label>
        <div class="nino-fields">
          <input
            type="text"
            name="nino_${i}_nombre"
            placeholder="Nombre"
            required
            style="flex:2"
          />
          <input
            type="number"
            name="nino_${i}_edad"
            placeholder="Edad"
            min="0"
            max="17"
            required
            style="flex:1"
          />
        </div>
      `;
      container.appendChild(group);
    }
  });

  // Toggle bus plazas
  const busPlazasBlock = document.getElementById('bus-plazas-block')!;
  const busNo = document.getElementById('bus-no') as HTMLInputElement;
  document.querySelectorAll('input[name="autobus"]').forEach((el) => {
    el.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      busPlazasBlock.style.display = val !== 'No lo necesitaré' ? 'flex' : 'none';
    });
  });

  // Form submit via fetch (Formspree AJAX)
  const form = document.getElementById('rsvp-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('.submit-btn') as HTMLButtonElement;
    btn.textContent = 'Enviando...';
    btn.disabled = true;

    try {
      // Convertir FormData a objeto JSON (agrupa checkboxes con múltiples valores)
      const fd = new FormData(form);
      const data: Record<string, string | string[]> = {};
      fd.forEach((value, key) => {
        const existing = data[key];
        if (existing !== undefined) {
          data[key] = Array.isArray(existing)
            ? [...existing, String(value)]
            : [existing, String(value)];
        } else {
          data[key] = String(value);
        }
      });

      const res = await fetch('/api/rsvp', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' },
      });

      const json = await res.json().catch(() => ({}));
      if (res.ok) {
        form.reset();
        successMsg.style.display = 'block';
        errorMsg.style.display = 'none';
        btn.style.display = 'none';
      } else {
        console.error('RSVP error:', json);
        throw new Error(json.debug || 'unknown');
      }
    } catch (err) {
      console.error('RSVP submit error:', err);
      errorMsg.style.display = 'block';
      btn.textContent = 'Enviar confirmación';
      btn.disabled = false;
    }
  });
</script>
