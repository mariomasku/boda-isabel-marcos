---
import SectionTitle from './SectionTitle.astro';
---
<section id="rsvp" class="rsvp-section">
  <div class="rsvp-container">
    <p class="section-subtitle gsap-fade">confirma tu asistencia</p>
    <SectionTitle>¿Contamos contigo?</SectionTitle>
    <p class="rsvp-intro gsap-fade">
      Por favor, confirma tu asistencia antes del <strong><br>1 de septiembre de 2026</strong>.
      <br><br>Si no vienes, también te agradeceremos si nos lo indicas.
    </p>

    <form
      id="rsvp-form"
      class="rsvp-form gsap-fade"
      method="POST"
    >
      <!-- 1. Nombre -->
      <div class="form-group">
        <label for="nombre">1. Nombre completo y apellidos *</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre completo" />
      </div>

      <!-- 2. Asistencia -->
      <div class="form-group">
        <label>2. ¿Asistirás a nuestra boda? *</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="asistencia" value="Sí, ¡allí estaré!" required />
            <span>Sí, ¡allí estaré!</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="asistencia" value="No, me lo perderé con todo el dolor de mi corazón" />
            <span>No, me lo perderé con todo el dolor de mi corazón</span>
          </label>
        </div>
      </div>

      <!-- Preguntas adicionales: solo si asistencia = Sí -->
      <div id="extras-si" class="extras-si">

      <!-- 3. Acompañante -->
      <div class="form-group">
        <label>3. ¿Vienes con acompañante?</label>
        <div class="radio-group" id="acompanante-radios">
          <label class="radio-option">
            <input type="radio" name="acompanante" value="si" id="acomp-si" />
            <span>Sí</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="acompanante" value="no" id="acomp-no" />
            <span>No</span>
          </label>
        </div>
        <div class="conditional" id="acomp-nombre-block" style="display:none">
          <input type="text" id="acompanante_nombre" name="acompanante_nombre" placeholder="Nombre completo de tu acompañante" />
        </div>
      </div>

      <!-- 4. Niños -->
      <div class="form-group">
        <label>4. ¿Traes niños?</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="ninos" value="si" id="ninos-si" />
            <span>Sí</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="ninos" value="no" id="ninos-no" />
            <span>No</span>
          </label>
        </div>
      </div>

      <!-- 5. Datos niños (dinámico) -->
      <div id="ninos-block" style="display:none" class="ninos-wrapper">
        <div class="form-group">
          <label>5. ¿Cuántos niños traes?</label>
          <div class="ninos-count-picker" id="ninos-count-picker">
            <button type="button" class="ninos-count-btn" data-value="1">1</button>
            <button type="button" class="ninos-count-btn" data-value="2">2</button>
            <button type="button" class="ninos-count-btn" data-value="3">3</button>
            <button type="button" class="ninos-count-btn" data-value="4">4</button>
            <button type="button" class="ninos-count-btn" data-value="5">5</button>
          </div>
          <input type="hidden" name="ninos_count" id="ninos_count" />
        </div>
        <div id="ninos-names-container"></div>
      </div>

      <!-- 6. Intolerancias alimentarias -->
      <div class="form-group">
        <label>6. ¿Algún miembro de tu grupo tiene alguna intolerancia o alergia alimentaria? *</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="tiene_intolerancias" value="no" id="intol-no" />
            <span>No, ninguno tiene alergias ni intolerancias</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="tiene_intolerancias" value="si" id="intol-si" />
            <span>Sí, alguien de mi grupo tiene intolerancias o alergias</span>
          </label>
        </div>
        <p class="intol-error" id="intol-error">Por favor, indica si hay o no alergias en tu grupo antes de continuar.</p>
        <div id="intol-personas-wrap" class="intol-personas-wrap">
          <p class="form-hint" style="margin-bottom:0.5rem">Selecciona cada persona para indicar sus restricciones alimentarias:</p>
          <div id="intol-personas-list" class="intol-personas-list"></div>
        </div>
      </div>

      <!-- 7. Bebida -->
      <div class="form-group">
        <label>7. ¿Qué bebida no puede faltar en la barra libre?</label>
        <div class="checkbox-group">
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Whisky" />
            <span>Whisky</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Ginebra" />
            <span>Ginebra</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Ron" />
            <span>Ron</span>
          </label>
          <label class="checkbox-option">
            <input type="checkbox" name="bebida" value="Vodka" />
            <span>Vodka</span>
          </label>
        </div>
      </div>

      <!-- 8. Autobús -->
      <div class="form-group">
        <label>8. Para los de Puente Genil: ¿necesitarás el autobús?</label>
        <div class="radio-group" id="bus-radios">
          <label class="radio-option">
            <input type="radio" name="autobus" value="Ida y vuelta" id="bus-idavuelta" />
            <span>Sí, ida y vuelta</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="Solo ida" />
            <span>Solo ida</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="Solo vuelta" />
            <span>Solo vuelta</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="autobus" value="No lo necesitaré" id="bus-no" />
            <span>No lo necesitaré</span>
          </label>
        </div>
      </div>

      <!-- 9. Plazas autobús -->
      <div class="form-group conditional" id="bus-plazas-block" style="display:none">
        <label>9. ¿Cuántas plazas necesitarías?</label>
        <div class="ninos-count-picker" id="bus-plazas-picker"></div>
        <input type="hidden" name="bus_plazas" id="bus_plazas" />
      </div>

      <!-- 10. Canción -->
      <div class="form-group">
        <label for="cancion">10. ¿Qué canción no puede faltar en la pista de baile?</label>
        <input type="text" id="cancion" name="cancion" placeholder="¡Esa que hace que lo des todo!" />
      </div>

      <!-- 11. Comentarios -->
      <div class="form-group">
        <label for="comentarios">11. ¿Tienes alguna otra duda o comentario?</label>
        <textarea id="comentarios" name="comentarios" rows="4" placeholder="Cuéntanos..."></textarea>
        <div class="photo-hint">
          <img src="/icons/fotos.svg" alt="" aria-hidden="true" class="photo-hint-icon" />
          <p class="photo-hint-text">Si tienes pensado hacernos una sorpresa durante la cena, por favor, ponte en contacto con nuestro fotógrafo para que pueda captar ese momento tan especial.</p>
          <div class="photo-hint-contact">
            <strong class="photo-hint-name">Rafael Badía</strong>
            <a href="tel:+34637352642" class="photo-hint-tel">637 35 26 42</a>
          </div>
        </div>
      </div>

      </div><!-- /#extras-si -->

      <button type="submit" class="submit-btn">Enviar confirmación</button>

      <div id="form-error" class="form-message error" style="display:none">
        Algo ha ido mal. Por favor, inténtalo de nuevo o escríbenos directamente.
      </div>
    </form>
  </div>
</section>

<!-- Modal: confirmación de envío exitoso -->
<div class="success-overlay" id="success-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Confirmación recibida">
  <div class="success-modal">
    <div class="success-icon">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M8 12.5l2.5 2.5L16 9.5"/>
      </svg>
    </div>
    <h2 class="success-title">¡Gracias!</h2>
    <p class="success-text">Hemos recibido tu confirmación.<br>¡Nos vemos el 3 de octubre! 🎉</p>
    <button type="button" class="success-accept" id="success-accept">Aceptar</button>
  </div>
</div>

<style>
  .rsvp-section {
    padding: 6rem 1.5rem;
    background: var(--crema);
  }

  .rsvp-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .rsvp-intro {
    text-align: center;
    color: var(--salvia);
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .rsvp-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .form-group > label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--eucalipto);
    font-weight: 400;
  }

  .form-hint {
    font-size: 0.82rem;
    color: var(--salvia);
    font-style: italic;
    line-height: 1.6;
  }

  .photo-hint {
    margin-top: 0.8rem;
    padding: 1.8rem 1.5rem;
    background: color-mix(in srgb, var(--oro) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--oro) 28%, transparent);
    border-top: 3px solid var(--oro);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .photo-hint-icon {
    width: 48px;
    height: 48px;
    filter: brightness(0) sepia(1) saturate(0.5) brightness(0.65);
    opacity: 0.8;
  }

  .photo-hint-text {
    font-family: 'Lato', sans-serif;
    font-size: 0.95rem;
    color: var(--salvia);
    line-height: 1.8;
    font-style: italic;
  }

  .photo-hint-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--oro) 30%, transparent);
    width: 100%;
  }

  .photo-hint-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    color: var(--eucalipto);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .photo-hint-tel {
    display: inline-block;
    padding: 0.65rem 2rem;
    border: 1px solid var(--oro);
    color: var(--salvia);
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    transition: background 0.2s, color 0.2s;
  }

  .photo-hint-tel:hover {
    background: var(--oro);
    color: white;
  }

  input[type="text"],
  input[type="email"],
  textarea,
  select {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--marfil);
    border: 1px solid color-mix(in srgb, var(--oro) 50%, transparent);
    border-radius: 0;
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    color: var(--eucalipto);
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
  }

  input[type="text"]:focus,
  textarea:focus,
  select:focus {
    border-color: var(--oro);
  }

  textarea { resize: vertical; }

  .radio-group,
  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-option,
  .checkbox-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    padding: 0.7rem 1rem;
    background: var(--marfil);
    border: 1px solid color-mix(in srgb, var(--oro) 30%, transparent);
    transition: border-color 0.2s, background 0.2s;
    font-size: 0.9rem;
    color: var(--eucalipto);
  }

  .radio-option:hover,
  .checkbox-option:hover {
    border-color: var(--oro);
    background: color-mix(in srgb, var(--oro) 8%, transparent);
  }

  .radio-option input,
  .checkbox-option input {
    accent-color: var(--salvia);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .conditional {
    margin-top: 0.5rem;
  }

  .submit-btn {
    align-self: center;
    padding: 1rem 3rem;
    background: var(--eucalipto);
    color: var(--marfil);
    border: none;
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
    margin-top: 1rem;
  }

  .submit-btn:hover {
    background: var(--salvia);
    transform: translateY(-2px);
  }

  /* ── Extras condicionales (solo si asistirá) ── */
  .extras-si {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      max-height 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.45s ease;
  }

  .extras-si.visible {
    max-height: 9000px;
    opacity: 1;
    pointer-events: auto;
  }

  .ninos-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.2rem;
    background: color-mix(in srgb, var(--oro) 8%, transparent);
    border-left: 2px solid var(--oro);
  }

  .ninos-count-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  #ninos-names-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }


  .form-message {
    text-align: center;
    padding: 1rem;
    font-size: 0.9rem;
    border-radius: 0;
  }

  .form-message.error {
    background: rgba(180,60,60,0.1);
    border: 1px solid #B44;
    color: #922;
  }

  /* ── Q6 Intolerancias ── */
  .intol-error {
    display: none;
    color: #b44;
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    margin-top: 0.4rem;
    font-style: normal;
  }

  .intol-personas-wrap { display: none; margin-top: 0.75rem; }

  .intol-personas-list { display: flex; flex-direction: column; gap: 0.5rem; }

</style>

<style is:global>
  /* ── Botones de picker (generados por JS, sin scoping de Astro) ── */
  .ninos-count-btn {
    width: 56px;
    height: 56px;
    border: 1.5px solid color-mix(in srgb, var(--oro) 50%, transparent);
    background: var(--marfil);
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    color: var(--eucalipto);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .ninos-count-btn:active { background: color-mix(in srgb, var(--oro) 18%, transparent); }
  .ninos-count-btn.selected {
    background: var(--eucalipto);
    color: var(--marfil);
    border-color: var(--eucalipto);
  }

  /* ── Intolerancias: elementos generados por JS (sin scoping de Astro) ── */

  .intol-person-card {
    border: 1px solid color-mix(in srgb, var(--oro) 35%, transparent);
    background: var(--marfil);
    overflow: hidden;
  }

  .intol-person-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    transition: background 0.2s;
    min-height: 56px; /* touch target */
  }

  .intol-person-btn:active { background: color-mix(in srgb, var(--oro) 12%, transparent); }

  .intol-person-name {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--eucalipto);
    flex: 1;
  }

  .intol-person-badge {
    font-family: 'Lato', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--salvia);
    padding: 0.2rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
    white-space: nowrap;
  }

  .intol-count {
    font-family: 'Lato', sans-serif;
    font-size: 0.66rem;
    color: white;
    background: var(--salvia);
    padding: 0.18rem 0.5rem;
    display: none;
    white-space: nowrap;
  }
  .intol-count.visible { display: inline-block; }

  .intol-chevron {
    color: color-mix(in srgb, var(--oro) 70%, transparent);
    font-size: 0.65rem;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .intol-person-card.open .intol-chevron { transform: rotate(180deg); }

  /* Panel: acordeón con max-height para transición suave */
  .intol-panel {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 0;
    overflow: hidden;
    padding: 0 0;
    background: color-mix(in srgb, var(--oro) 4%, transparent);
    transition: max-height 0.38s ease, padding 0.3s ease;
  }
  .intol-person-card.open .intol-panel {
    max-height: 900px;
    padding: 0.5rem 0 1rem;
    border-top: 1px solid color-mix(in srgb, var(--oro) 20%, transparent);
  }

  /* Checkboxes: columna única, táctiles */
  .intol-checkboxes {
    display: flex;
    flex-direction: column;
  }
  .intol-check-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Lato', sans-serif;
    font-size: 0.88rem;
    color: var(--eucalipto);
    cursor: pointer;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 10%, transparent);
    transition: background 0.15s;
    min-height: 48px; /* touch target */
  }
  .intol-check-label:last-child { border-bottom: none; }
  .intol-check-label:active { background: color-mix(in srgb, var(--oro) 9%, transparent); }
  .intol-check-label input[type="checkbox"] {
    width: 18px;
    min-width: 18px;
    height: 18px;
    accent-color: var(--salvia);
    flex-shrink: 0;
    cursor: pointer;
  }

  .intol-otros-wrap {
    margin: 0.5rem 1rem 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--oro) 20%, transparent);
  }
  .intol-otros-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    color: var(--salvia);
    display: block;
    margin-bottom: 0.4rem;
  }

  /* "Otros alérgenos" input — contenido dinámico */
  .intol-otros-wrap input[type="text"] {
    width: 100%;
    box-sizing: border-box;
    padding: 0.85rem 1rem;
    background: var(--marfil);
    border: 1.5px solid color-mix(in srgb, var(--oro) 55%, transparent);
    font-family: 'Lato', sans-serif;
    font-size: 0.88rem;
    color: var(--eucalipto);
    outline: none;
  }
  .intol-otros-wrap input[type="text"]:focus {
    border-color: var(--oro);
  }

  /* ── Niños: entradas dinámicas ── */
  .nino-entry {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1rem 1.2rem;
    background: var(--marfil);
    border: 1.5px solid color-mix(in srgb, var(--oro) 45%, transparent);
  }

  .nino-entry-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--eucalipto);
    margin-bottom: 0.2rem;
    display: block;
  }

  .nino-campo-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--salvia);
    display: block;
    margin-top: 0.55rem;
  }

  .nino-entry input[type="text"],
  .nino-entry input[type="number"] {
    width: 100%;
    box-sizing: border-box;
    padding: 0.88rem 1rem;
    background: white;
    border: 1.5px solid color-mix(in srgb, var(--oro) 55%, transparent);
    font-family: 'Lato', sans-serif;
    font-size: 0.92rem;
    color: var(--eucalipto);
    outline: none;
    appearance: none;
    -moz-appearance: textfield;
  }
  .nino-entry input[type="text"]:focus,
  .nino-entry input[type="number"]:focus {
    border-color: var(--oro);
  }

  /* ── Modal: confirmación de envío exitoso ── */
  .success-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--eucalipto-noche) 82%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.25s ease;
    padding: 1rem;
  }
  .success-overlay.open { opacity: 1; }

  .success-modal {
    position: relative;
    background: linear-gradient(160deg, var(--eucalipto-oscuro), var(--eucalipto-noche));
    border: 1px solid color-mix(in srgb, var(--oro) 28%, transparent);
    padding: 2.5rem 2rem 2rem;
    max-width: 360px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    transform: translateY(14px);
    transition: transform 0.28s ease;
    box-shadow: 0 24px 64px rgba(0,0,0,0.65);
  }
  .success-overlay.open .success-modal { transform: translateY(0); }

  .success-icon {
    color: var(--oro);
    margin-bottom: 0.3rem;
  }

  .success-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    color: var(--marfil);
    margin: 0;
  }

  .success-text {
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--marfil) 80%, transparent);
    margin: 0 0 0.5rem;
  }

  .success-accept {
    width: 100%;
    background: color-mix(in srgb, var(--oro) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
    color: var(--oro);
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.85rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .success-accept:hover {
    background: color-mix(in srgb, var(--oro) 22%, transparent);
    color: var(--marfil);
  }
</style>

<script>
  // ── Mostrar/ocultar extras según asistencia ──
  const extrasSi = document.getElementById('extras-si')!;
  document.querySelectorAll<HTMLInputElement>('input[name="asistencia"]').forEach((el) => {
    el.addEventListener('change', () => {
      const asiste = el.value.startsWith('Sí');
      extrasSi.classList.toggle('visible', asiste);
      if (!asiste) {
        (document.getElementById('acomp-nombre-block') as HTMLElement).style.display = 'none';
        (document.getElementById('ninos-block') as HTMLElement).style.display = 'none';
        resetNinosCount();
        (document.getElementById('bus-plazas-block') as HTMLElement).style.display = 'none';
        document.querySelectorAll<HTMLInputElement>('#extras-si input[type="radio"], #extras-si input[type="checkbox"]')
          .forEach(i => { i.checked = false; });
        resetIntolerancias();
      }
    });
  });

  // ── Toggle acompañante nombre ──
  const acSi    = document.getElementById('acomp-si') as HTMLInputElement;
  const acNo    = document.getElementById('acomp-no') as HTMLInputElement;
  const acBlock = document.getElementById('acomp-nombre-block')!;
  acSi?.addEventListener('change', () => { acBlock.style.display = 'block'; refreshIntolList(); buildBusPlazasBtns(); });
  acNo?.addEventListener('change', () => { acBlock.style.display = 'none';  refreshIntolList(); buildBusPlazasBtns(); });

  // ── Toggle niños block ──
  const ninosSi    = document.getElementById('ninos-si') as HTMLInputElement;
  const ninosNo    = document.getElementById('ninos-no') as HTMLInputElement;
  const ninosBlock = document.getElementById('ninos-block')!;
  ninosSi?.addEventListener('change', () => { ninosBlock.style.display = 'flex'; refreshIntolList(); });
  ninosNo?.addEventListener('change', () => {
    ninosBlock.style.display = 'none';
    resetNinosCount();
    refreshIntolList();
  });

  // ── Picker de número de niños ──
  function buildNinoFields(count: number) {
    const container = document.getElementById('ninos-names-container')!;
    container.innerHTML = '';
    for (let i = 1; i <= count; i++) {
      const group = document.createElement('div');
      group.className = 'nino-entry';
      group.innerHTML = `
        <span class="nino-entry-title">Niño/a ${i}</span>
        <span class="nino-campo-label">Nombre</span>
        <input type="text" name="nino_${i}_nombre" id="nino_${i}_nombre" placeholder="Nombre completo" required />
        <span class="nino-campo-label">Edad</span>
        <input type="number" name="nino_${i}_edad" placeholder="Años (0–17)" min="0" max="17" required />
      `;
      container.appendChild(group);
      document.getElementById(`nino_${i}_nombre`)?.addEventListener('input', refreshIntolList);
    }
    refreshIntolList();
  }

  function resetNinosCount() {
    document.querySelectorAll<HTMLButtonElement>('#ninos-count-picker .ninos-count-btn').forEach(b => b.classList.remove('selected'));
    (document.getElementById('ninos_count') as HTMLInputElement).value = '';
    document.getElementById('ninos-names-container')!.innerHTML = '';
  }

  document.getElementById('ninos-count-picker')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ninos-count-btn');
    if (!btn) return;
    const val = btn.dataset.value ?? '';
    document.querySelectorAll<HTMLButtonElement>('#ninos-count-picker .ninos-count-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    (document.getElementById('ninos_count') as HTMLInputElement).value = val;
    buildNinoFields(parseInt(val) || 0);
    buildBusPlazasBtns();
  });

  // ── Plazas de autobús — picker dinámico ──
  function getTotalPersonas(): number {
    let total = 1; // invitado siempre
    if ((document.getElementById('acomp-si') as HTMLInputElement)?.checked) total += 1;
    total += parseInt((document.getElementById('ninos_count') as HTMLInputElement)?.value || '0') || 0;
    return total;
  }

  function buildBusPlazasBtns() {
    const picker  = document.getElementById('bus-plazas-picker')!;
    const hidden  = document.getElementById('bus_plazas') as HTMLInputElement;
    const current = hidden?.value ?? '';
    const total   = getTotalPersonas();
    picker.innerHTML = '';
    for (let i = 1; i <= total; i++) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ninos-count-btn' + (String(i) === current ? ' selected' : '');
      btn.dataset.value = String(i);
      btn.textContent = String(i);
      picker.appendChild(btn);
    }
    // Si la selección actual supera el nuevo total, limpiarla
    if (current && parseInt(current) > total) hidden.value = '';
  }

  document.getElementById('bus-plazas-picker')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ninos-count-btn');
    if (!btn) return;
    const val = btn.dataset.value ?? '';
    document.querySelectorAll<HTMLButtonElement>('#bus-plazas-picker .ninos-count-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    (document.getElementById('bus_plazas') as HTMLInputElement).value = val;
  });

  const busPlazasBlock = document.getElementById('bus-plazas-block')!;
  document.querySelectorAll('input[name="autobus"]').forEach((el) => {
    el.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (val !== 'No lo necesitaré') {
        busPlazasBlock.style.display = 'flex';
        buildBusPlazasBtns();
      } else {
        busPlazasBlock.style.display = 'none';
        (document.getElementById('bus_plazas') as HTMLInputElement).value = '';
      }
    });
  });

  // ══════════════════════════════════════════
  // Q6 — INTOLERANCIAS ALIMENTARIAS
  // ══════════════════════════════════════════

  const INTOL_ITEMS: [string, string][] = [
    ['GLUTEN',       'Gluten (celiaquía o sensibilidad al gluten)'],
    ['LACTOSA',      'Lactosa / lácteos'],
    ['HUEVO',        'Huevo'],
    ['FRUTOS_SECOS', 'Frutos secos (almendras, nueces, avellanas, etc.)'],
    ['CACAHUETE',    'Cacahuete'],
    ['MARISCO',      'Marisco'],
    ['PESCADO',      'Pescado'],
    ['SOJA',         'Soja'],
    ['SESAMO',       'Sésamo'],
    ['MOSTAZA',      'Mostaza'],
    ['APIO',         'Apio'],
    ['SULFITOS',     'Sulfitos (vino, frutos secos tratados, etc.)'],
    ['ALTRAMUCES',   'Altramuces (lupino)'],
    ['MOLUSCOS',     'Moluscos (mejillones, almejas, pulpo, calamar, etc.)'],
  ];

  function getGroupPersons() {
    const persons: { id: string; nombre: string; badge: string }[] = [];
    const nombreInv = (document.getElementById('nombre') as HTMLInputElement)?.value?.trim() || 'Tú';
    persons.push({ id: 'invitado', nombre: nombreInv, badge: 'Invitado/a' });
    if ((document.getElementById('acomp-si') as HTMLInputElement)?.checked) {
      const acN = (document.getElementById('acompanante_nombre') as HTMLInputElement)?.value?.trim() || 'Acompañante';
      persons.push({ id: 'acompanante', nombre: acN, badge: 'Acompañante' });
    }
    if ((document.getElementById('ninos-si') as HTMLInputElement)?.checked) {
      const cnt = parseInt((document.getElementById('ninos_count') as HTMLSelectElement)?.value) || 0;
      for (let i = 1; i <= cnt; i++) {
        const nn = (document.getElementById(`nino_${i}_nombre`) as HTMLInputElement)?.value?.trim() || `Niño/a ${i}`;
        persons.push({ id: `nino_${i}`, nombre: nn, badge: 'Niño/a' });
      }
    }
    return persons;
  }

  function buildCheckboxGrid(personId: string) {
    return `<div class="intol-checkboxes">
      ${INTOL_ITEMS.map(([val, label]) =>
        `<label class="intol-check-label"><input type="checkbox" name="intol_${personId}" value="${val}" />${label}</label>`
      ).join('')}
    </div>
    <div class="intol-otros-wrap">
      <span class="intol-otros-label">Otros:</span>
      <input type="text" name="intol_${personId}_otros" placeholder="Especifica otros alérgenos..." />
    </div>`;
  }

  function saveIntolSelections() {
    const saved: Record<string, string[]> = {};
    document.querySelectorAll<HTMLInputElement>('[name^="intol_"]').forEach(el => {
      if (el.type === 'checkbox' && el.checked) (saved[el.name] ??= []).push(el.value);
      else if (el.type === 'text' && el.value)   saved[el.name] = [el.value];
    });
    return saved;
  }

  function restoreIntolSelections(saved: Record<string, string[]>) {
    Object.entries(saved).forEach(([name, values]) => {
      document.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach(el => {
        if (el.type === 'checkbox') el.checked = values.includes(el.value);
        else if (el.type === 'text') el.value = values[0] ?? '';
      });
    });
  }

  function updateCountBadge(personId: string) {
    const count = document.querySelectorAll<HTMLInputElement>(`input[name="intol_${personId}"]:checked`).length;
    const badge = document.querySelector<HTMLElement>(`#intol-card-${personId} .intol-count`);
    if (!badge) return;
    badge.textContent = count > 0 ? `${count} seleccionada${count !== 1 ? 's' : ''}` : '';
    badge.classList.toggle('visible', count > 0);
  }

  function refreshIntolList() {
    if (!(document.getElementById('intol-si') as HTMLInputElement)?.checked) return;
    const saved   = saveIntolSelections();
    const persons = getGroupPersons();
    const list    = document.getElementById('intol-personas-list')!;
    list.innerHTML = persons.map(p => `
      <div class="intol-person-card" id="intol-card-${p.id}">
        <button type="button" class="intol-person-btn" data-pid="${p.id}">
          <span class="intol-person-name">${p.nombre}</span>
          <span class="intol-person-badge">${p.badge}</span>
          <span class="intol-count"></span>
          <span class="intol-chevron">▼</span>
        </button>
        <div class="intol-panel">${buildCheckboxGrid(p.id)}</div>
      </div>`).join('');

    list.querySelectorAll<HTMLButtonElement>('.intol-person-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card   = btn.closest('.intol-person-card')!;
        const isOpen = card.classList.contains('open');
        list.querySelectorAll('.intol-person-card').forEach(c => c.classList.remove('open'));
        if (!isOpen) card.classList.add('open');
      });
    });
    list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(cb => {
      const pid = cb.name.replace('intol_', '');
      cb.addEventListener('change', () => updateCountBadge(pid));
    });

    restoreIntolSelections(saved);
    persons.forEach(p => updateCountBadge(p.id));
  }

  function resetIntolerancias() {
    (document.getElementById('intol-no') as HTMLInputElement).checked = false;
    (document.getElementById('intol-si') as HTMLInputElement).checked = false;
    document.getElementById('intol-personas-wrap')!.style.display = 'none';
    document.getElementById('intol-personas-list')!.innerHTML = '';
    (document.getElementById('intol-error') as HTMLElement).style.display = 'none';
  }

  document.getElementById('intol-si')?.addEventListener('change', () => {
    document.getElementById('intol-personas-wrap')!.style.display = 'block';
    document.getElementById('intol-error')!.style.display = 'none';
    refreshIntolList();
  });
  document.getElementById('intol-no')?.addEventListener('change', () => {
    document.getElementById('intol-personas-wrap')!.style.display = 'none';
    document.getElementById('intol-error')!.style.display = 'none';
  });

  document.getElementById('nombre')?.addEventListener('input', refreshIntolList);
  document.getElementById('acompanante_nombre')?.addEventListener('input', refreshIntolList);

  // ── Modal de confirmación de envío ──
  const successOverlay = document.getElementById('success-overlay') as HTMLElement;

  function openSuccessModal() {
    successOverlay.style.display = 'flex';
    successOverlay.getBoundingClientRect(); // forzar reflow para la transición
    successOverlay.classList.add('open');
  }

  function closeSuccessModal() {
    successOverlay.classList.remove('open');
    successOverlay.addEventListener('transitionend', () => {
      successOverlay.style.display = 'none';
    }, { once: true });
  }

  document.getElementById('success-accept')?.addEventListener('click', closeSuccessModal);
  successOverlay.addEventListener('click', (e) => { if (e.target === successOverlay) closeSuccessModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && successOverlay.classList.contains('open')) closeSuccessModal(); });

  // ── Form submit ──
  const form = document.getElementById('rsvp-form') as HTMLFormElement;
  const errorMsg   = document.getElementById('form-error')!;

  // Limpia todos los campos, incluido el estado dinámico (acordeones, pickers, campos generados)
  function resetFormCompleto() {
    form.reset();
    extrasSi.classList.remove('visible');
    (document.getElementById('acomp-nombre-block') as HTMLElement).style.display = 'none';
    (document.getElementById('ninos-block') as HTMLElement).style.display = 'none';
    (document.getElementById('bus-plazas-block') as HTMLElement).style.display = 'none';
    resetNinosCount();
    resetIntolerancias();
    document.getElementById('bus-plazas-picker')!.innerHTML = '';
    (document.getElementById('bus_plazas') as HTMLInputElement).value = '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('.submit-btn') as HTMLButtonElement;

    // Validar Q6 cuando se confirma asistencia
    const asiste = form.querySelector<HTMLInputElement>('input[name="asistencia"]:checked')?.value?.startsWith('Sí');
    if (asiste && !form.querySelector<HTMLInputElement>('input[name="tiene_intolerancias"]:checked')) {
      const errEl = document.getElementById('intol-error')!;
      errEl.style.display = 'block';
      errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    btn.textContent = 'Enviando...';
    btn.disabled = true;

    try {
      const fd = new FormData(form);
      const data: Record<string, string | string[]> = {};
      fd.forEach((value, key) => {
        const existing = data[key];
        if (existing !== undefined) {
          data[key] = Array.isArray(existing) ? [...existing, String(value)] : [existing, String(value)];
        } else {
          data[key] = String(value);
        }
      });

      const res = await fetch('/api/rsvp', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' },
      });

      const json = await res.json().catch(() => ({}));
      if (res.ok) {
        resetFormCompleto();
        errorMsg.style.display = 'none';
        btn.textContent = 'Enviar confirmación';
        btn.disabled = false;
        openSuccessModal();
      } else {
        console.error('RSVP error:', json);
        throw new Error(json.debug || 'unknown');
      }
    } catch (err) {
      console.error('RSVP submit error:', err);
      errorMsg.style.display = 'block';
      btn.textContent = 'Enviar confirmación';
      btn.disabled = false;
    }
  });
</script>
