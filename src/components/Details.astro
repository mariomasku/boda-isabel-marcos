---
<section id="detalles" class="details-section">
  <div class="container">
    <p class="section-subtitle gsap-fade">la celebración</p>
    <h2 class="section-title gsap-fade">El gran día</h2>
    <div class="ornament gsap-fade">
      <span style="color: var(--gold); font-size:1.2rem;">✦</span>
    </div>

    <div class="timeline-v gsap-fade">

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/position.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">17:30h</time>
          <p class="tl-label">Salida de autocar<br>Puente Genil · Córdoba</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/anillos.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time tl-time--main">19:00h</time>
          <p class="tl-label">Ceremonia</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/coctel.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">20:00h</time>
          <p class="tl-label">Cóctel</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/fotos.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">21:30h</time>
          <p class="tl-label">Cena</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/bus.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">03:00h</time>
          <p class="tl-label">Primer autocar<br>Córdoba · Puente Genil</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/bus.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">06:00h</time>
          <p class="tl-label">Segundo autocar<br>Córdoba · Puente Genil</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/ceremonia.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <!-- sin stem: último ítem -->
        </div>
        <div class="tl-right">
          <time class="tl-time">06:00h</time>
          <p class="tl-label">Fin de fiesta</p>
        </div>
      </div>

    </div>

    <div class="details-grid">
      <div class="detail-card gsap-fade">
        <div class="detail-icon">📅</div>
        <h3>Fecha</h3>
        <p>Sábado, 3 de octubre</p>
        <p class="detail-sub">2026</p>
      </div>
      <div class="detail-card gsap-fade">
        <div class="detail-icon">📍</div>
        <h3>Lugar</h3>
        <p>Cortijo El Alamillo</p>
        <p class="detail-sub">Villarrubia, Córdoba</p>
      </div>
      <div class="detail-card gsap-fade">
        <div class="detail-icon">📸</div>
        <h3>Fotógrafo</h3>
        <p>Rafael Badia</p>
        <p class="detail-sub">Si tienes pensado darnos una sorpresa, contacta con él:</p>
        <a href="tel:+34637352642" class="detail-link">637 35 26 42</a>
      </div>
    </div>
  </div>

  <!-- Mapa -->
  <div class="map-wrapper gsap-fade">
    <div class="map-label">
      <span>📍 Cortijo El Alamillo · Villarrubia, Córdoba</span>
      <a
        href="https://share.google/S2dETBj80LCp9TyRZ"
        target="_blank"
        rel="noopener"
        class="map-open-link"
      >Abrir en Google Maps →</a>
    </div>
    <iframe
      title="Localización del Cortijo El Alamillo"
      src="https://maps.google.com/maps?q=Cortijo+El+Alamillo,+Villarrubia,+Córdoba,+Spain&output=embed&z=14"
      width="100%"
      height="400"
      style="border:0"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>

<style>
  .details-section {
    padding: 6rem 1.5rem 0;
    background: var(--ivory);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-bottom: 4rem;
  }

  .section-subtitle { margin-bottom: 0.25rem; }
  .section-title { margin-bottom: 0; }

  /* ── Vertical timeline ── */
  .timeline-v {
    width: 100%;
    max-width: 380px;
    margin: 2.5rem auto;
  }

  .tl-item {
    display: flex;
    gap: 2.4rem;
  }

  /* Columna izquierda: icono + línea vertical */
  .tl-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 80px;
  }

  .tl-icon-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid rgba(196,168,130,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tl-icon {
    width: 48px;
    height: 48px;
    filter: brightness(0) sepia(1) saturate(0.5) brightness(0.65);
  }

  /* Línea que conecta con el siguiente icono */
  .tl-stem {
    flex: 1;
    width: 1px;
    min-height: 24px;
    background: var(--gold);
    opacity: 0.4;
    margin: 5px 0;
  }

  /* Columna derecha: hora encima, etiqueta debajo */
  .tl-right {
    width: max-content;
    padding-top: 0.75rem;
    padding-bottom: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tl-time {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--brown);
    font-style: italic;
    display: block;
    line-height: 1;
  }

  .tl-time--main {
    font-size: 1.45rem;
  }

  .tl-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-dark);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Info cards ── */
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    width: 100%;
    margin-top: 1.5rem;
  }

  .detail-card {
    background: var(--cream);
    padding: 2rem 1.5rem;
    text-align: center;
    border-bottom: 2px solid var(--gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .detail-icon { font-size: 1.8rem; margin-bottom: 0.5rem; }

  .detail-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--brown);
  }

  .detail-card p {
    font-family: 'Lato', sans-serif;
    color: var(--text);
    font-size: 0.95rem;
  }

  .detail-sub {
    font-size: 0.82rem !important;
    color: var(--brown-light) !important;
    margin-top: 0.2rem;
  }

  .detail-link {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--gold-dark);
    text-decoration: none;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 1px;
    transition: color 0.2s;
  }

  .detail-link:hover { color: var(--brown); }

  /* ── Mapa ── */
  .map-wrapper {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .map-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    background: var(--cream);
    border-top: 2px solid var(--gold);
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    color: var(--brown);
  }

  .map-open-link {
    color: var(--gold-dark);
    text-decoration: none;
    font-size: 0.8rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .map-open-link:hover { color: var(--brown); }

  .map-wrapper iframe {
    display: block;
    filter: grayscale(20%) contrast(1.05);
  }

  @media (max-width: 480px) {
    .tl-icon-wrap { width: 80px; height: 80px; }
    .tl-icon { width: 48px; height: 48px; }
    .tl-left { width: 44px; }
    .map-label { flex-direction: column; gap: 0.4rem; text-align: center; }
    .timeline-v { margin-left: 4rem;}
  }
</style>
