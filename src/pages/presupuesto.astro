---
export const prerender = true;
import '../styles/global.css';
import AdminNav from '../components/AdminNav.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Presupuesto · Isabel & Marcos</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --border:     color-mix(in srgb, var(--oro) 28%, transparent);
      --text-soft:  color-mix(in srgb, var(--sombra) 55%, transparent);
      --card-shadow: 0 1px 3px color-mix(in srgb, var(--sombra) 6%, transparent), 0 4px 12px color-mix(in srgb, var(--sombra) 4%, transparent);
    }

    body {
      font-family: 'Lato', sans-serif;
      background: var(--marfil);
      min-height: 100vh;
      color: var(--eucalipto);
    }

    /* ── Header ── */
    .dash-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      background: var(--eucalipto);
      border-bottom: 2px solid var(--oro);
    }
    .dash-logo-wrap-group { display: flex; align-items: center; gap: 0.85rem; }
    .dash-logo-wrap { display: flex; flex-direction: column; gap: 2px; }
    .dash-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem;
      font-style: italic;
      color: var(--oro);
    }
    .dash-logo-sub {
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--oro) 50%, transparent);
    }
    .dash-actions { display: flex; gap: 0.6rem; align-items: center; }
    .btn-ghost {
      padding: 0.4rem 0.9rem;
      border: 1px solid color-mix(in srgb, var(--oro) 35%, transparent);
      background: transparent;
      color: color-mix(in srgb, var(--oro) 70%, transparent);
      font-family: 'Lato', sans-serif;
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-ghost:hover { background: color-mix(in srgb, var(--oro) 12%, transparent); color: var(--oro); }
    .btn-back-full  { display: inline; }
    .btn-back-short { display: none; }

    /* ── Main ── */
    .dash-main { max-width: 780px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

    .dash-page-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      font-weight: 400;
      font-style: italic;
      color: var(--eucalipto);
      margin-bottom: 0.2rem;
    }
    .dash-page-sub {
      font-size: 0.68rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--text-soft);
      margin-bottom: 2rem;
    }

    #b-loading, #b-error {
      text-align: center;
      padding: 3rem;
      color: var(--text-soft);
      font-size: 0.9rem;
    }
    #b-error { color: #b91c1c; }

    /* ── Total destacado ── */
    .total-card {
      background: var(--eucalipto);
      border-radius: 8px;
      border-top: 4px solid var(--oro);
      box-shadow: var(--card-shadow);
      padding: 1.8rem 1.5rem;
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .total-label {
      font-size: 0.65rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--oro) 65%, transparent);
      margin-bottom: 0.5rem;
    }
    .total-value {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.2rem, 7vw, 3rem);
      color: var(--oro);
      line-height: 1;
    }

    /* ── Section ── */
    .dash-section { margin-bottom: 2.5rem; }
    .section-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .section-label {
      font-size: 0.62rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--salvia);
      font-weight: 700;
    }
    .section-line { flex: 1; height: 1px; background: var(--border); }

    /* ── Tarjetas acordeón por categoría ── */
    .budget-list { display: flex; flex-direction: column; gap: 0.9rem; }
    .budget-empty { text-align: center; color: var(--text-soft); font-size: 0.82rem; padding: 1rem; }

    .budget-card {
      background: var(--blanco);
      border: 1px solid var(--border);
      border-left: 3px solid var(--oro);
      border-radius: 6px;
      box-shadow: var(--card-shadow);
      overflow: hidden;
    }
    .budget-card-header {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      width: 100%;
      padding: 0.9rem 1.1rem;
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
    }
    .budget-chevron { flex-shrink: 0; color: var(--salvia); transition: transform 0.2s; }
    .budget-chevron.open { transform: rotate(180deg); }
    .budget-card-title-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .budget-card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      font-style: italic;
      color: var(--eucalipto);
    }
    .budget-card-count {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-soft);
    }
    .budget-card-total {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      color: var(--salvia);
      flex-shrink: 0;
    }
    .budget-card-total.zero { color: color-mix(in srgb, var(--sombra) 25%, transparent); }

    .budget-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
      border-top: 0px solid var(--border);
    }
    .budget-body.open {
      max-height: 900px;
      border-top-width: 1px;
    }
    .budget-body-inner { padding: 0.9rem 1.1rem 1rem; display: flex; flex-direction: column; gap: 0.4rem; }

    .budget-concept {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      padding: 0.55rem 0.85rem;
      background: color-mix(in srgb, var(--oro) 8%, transparent);
      border-radius: 5px;
      font-size: 0.82rem;
    }
    .budget-concept-name { color: var(--eucalipto); }
    .budget-concept-field {
      font-size: 0.68rem;
      color: var(--text-soft);
      margin-left: 0.4rem;
    }
    .budget-concept-value {
      font-weight: 700;
      color: var(--salvia);
      flex-shrink: 0;
    }

    .budget-edit-link {
      display: inline-block;
      margin-top: 0.6rem;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--salvia);
      text-decoration: none;
      border-bottom: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
      padding-bottom: 1px;
    }
    .budget-edit-link:hover { color: var(--eucalipto); }

    @media (max-width: 580px) {
      #logout-btn { display: none; }
      .btn-back-full  { display: none; }
      .btn-back-short { display: inline; }
    }
  </style>
</head>
<body>

  <header class="dash-header">
    <div class="dash-logo-wrap-group">
      <AdminNav current="presupuesto" />
      <div class="dash-logo-wrap">
        <span class="dash-logo">Isabel <span style="font-style:normal;color:color-mix(in srgb, var(--oro) 50%, transparent)">&</span> Marcos</span>
        <span class="dash-logo-sub">Presupuesto</span>
      </div>
    </div>
    <div class="dash-actions">
      <a href="/dashboard" class="btn-ghost">
        <span class="btn-back-full">← Panel</span>
        <span class="btn-back-short">Volver</span>
      </a>
      <button class="btn-ghost" id="logout-btn">Salir</button>
    </div>
  </header>

  <main class="dash-main">
    <h1 class="dash-page-title">Presupuesto</h1>
    <p class="dash-page-sub">Suma de todos los conceptos con coste registrados en el gestor</p>

    <div id="b-loading">Calculando…</div>
    <div id="b-error" style="display:none"></div>

    <div id="b-content" style="display:none">
      <div class="total-card">
        <p class="total-label">Gasto total registrado</p>
        <p class="total-value" id="b-total">— €</p>
      </div>

      <div class="dash-section">
        <div class="section-header">
          <span class="section-label">Desglose por categoría</span>
          <div class="section-line"></div>
        </div>
        <div class="budget-list" id="budget-list"></div>
      </div>
    </div>
  </main>

  <script>
    if (sessionStorage.getItem('boda_auth') !== 'boda031026') {
      window.location.replace('/');
    }

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      sessionStorage.removeItem('boda_auth');
      window.location.href = '/';
    });

    type Concept = { nombre: string; fieldLabel: string; value: number };
    type CategoryBudget = { id: string; label: string; total: number; concepts: Concept[] };

    const expanded = new Set<string>();
    const fmt = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' €';
    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));

    async function loadBudget() {
      try {
        const res  = await fetch('/api/presupuesto');
        const json = await res.json();
        if (!json.ok) throw new Error(json.error ?? 'Error desconocido');
        render(json.grandTotal, json.categories);
      } catch (err) {
        document.getElementById('b-loading')!.style.display = 'none';
        const errEl = document.getElementById('b-error')!;
        errEl.style.display = 'block';
        errEl.textContent = 'No se pudo calcular el presupuesto: ' + (err instanceof Error ? err.message : String(err));
      }
    }

    function categoryCardHtml(cat: CategoryBudget): string {
      const isOpen = expanded.has(cat.id);
      const count  = cat.concepts.length === 1 ? '1 concepto' : `${cat.concepts.length} conceptos`;
      const body = cat.concepts.length
        ? cat.concepts.map(c => `
            <div class="budget-concept">
              <span class="budget-concept-name">${escapeHtml(c.nombre)}<span class="budget-concept-field">${escapeHtml(c.fieldLabel)}</span></span>
              <span class="budget-concept-value">${fmt(c.value)}</span>
            </div>`).join('') + `<a class="budget-edit-link" href="/planner/${cat.id}">Editar en ${escapeHtml(cat.label)} →</a>`
        : `<p class="budget-empty">Sin conceptos con coste todavía</p><a class="budget-edit-link" href="/planner/${cat.id}">Añadir en ${escapeHtml(cat.label)} →</a>`;

      return `
        <div class="budget-card" data-id="${cat.id}">
          <button type="button" class="budget-card-header" data-toggle="${cat.id}">
            <svg class="budget-chevron${isOpen ? ' open' : ''}" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg>
            <div class="budget-card-title-wrap">
              <span class="budget-card-title">${escapeHtml(cat.label)}</span>
              <span class="budget-card-count">${count}</span>
            </div>
            <span class="budget-card-total${cat.total === 0 ? ' zero' : ''}">${fmt(cat.total)}</span>
          </button>
          <div class="budget-body${isOpen ? ' open' : ''}" data-body="${cat.id}">
            <div class="budget-body-inner">${body}</div>
          </div>
        </div>`;
    }

    function render(grandTotal: number, categories: CategoryBudget[]) {
      document.getElementById('b-loading')!.style.display = 'none';
      document.getElementById('b-content')!.style.display = 'block';

      document.getElementById('b-total')!.textContent = fmt(grandTotal);

      const list = document.getElementById('budget-list')!;
      list.innerHTML = categories.length
        ? categories.map(categoryCardHtml).join('')
        : '<p class="budget-empty">Todavía no hay categorías con campos de coste</p>';
    }

    document.getElementById('budget-list')?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const toggleBtn = target.closest<HTMLElement>('[data-toggle]');
      if (!toggleBtn) return;
      const id = toggleBtn.dataset.toggle!;
      if (expanded.has(id)) expanded.delete(id); else expanded.add(id);
      const body    = document.querySelector<HTMLElement>(`.budget-body[data-body="${id}"]`);
      const chevron = toggleBtn.querySelector('.budget-chevron');
      body?.classList.toggle('open', expanded.has(id));
      chevron?.classList.toggle('open', expanded.has(id));
    });

    loadBudget();
  </script>
</body>
</html>
