---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import Details from '../components/Details.astro';
import Bus from '../components/Bus.astro';
import RSVP from '../components/RSVP.astro';
import Footer from '../components/Footer.astro';
import PhotoParallax from '../components/PhotoParallax.astro';
import '../styles/global.css';
---

<Layout>
  <nav id="navbar" class="navbar">
    <div class="nav-names"><span class="dash-logo">Isabel <span style="font-style:normal;color:color-mix(in srgb, var(--oro) 50%, transparent)">&</span> Marcos</span></div>
    <div class="nav-links">
      <a href="#detalles">El día</a>
      <a href="#autobus">Bús</a>
      <a href="#rsvp">Confirmar</a>
    </div>
  </nav>

  <main>
    <Hero />
    <Welcome />
    <Details />
    <PhotoParallax foto="/fotos/foto2.webp" height="60vh" />
    <Bus />
    <PhotoParallax foto="/fotos/foto3.webp" height="60vh" />
    <RSVP />
    <PhotoParallax foto="/fotos/foto4.webp" height="50vh" />
    <Footer />
  </main>
</Layout>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 2rem;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }

  .navbar.scrolled {
    background: color-mix(in srgb, var(--sombra) 92%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--oro) 15%, transparent);
  }

  .nav-names {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--oro);
    letter-spacing: 0;
    font-style: italic;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: color-mix(in srgb, var(--marfil) 80%, transparent);
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--oro); }

  @media (max-width: 480px) {
    .nav-links { gap: 1rem; }
    .nav-links a { font-size: 0.7rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Navbar scroll effect
  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  });

  // Hero: entrada escalonada del texto
  gsap.fromTo('.gsap-hero',
    { opacity: 0, y: 40 },
    {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.18,
      ease: 'power3.out',
      delay: 0.3,
    }
  );

  // Hero: parallax del fondo al hacer scroll
  gsap.to('.parallax-hero-bg', {
    yPercent: 25,
    ease: 'none',
    scrollTrigger: {
      trigger: '#hero',
      start: 'top top',
      end: 'bottom top',
      scrub: true,
    },
  });

  // Parallax en secciones de foto + zoom suave de imagen
  gsap.utils.toArray<HTMLElement>('.parallax-section').forEach((section) => {
    const bg = section.querySelector<HTMLElement>('.parallax-bg');
    if (!bg) return;
    gsap.fromTo(bg,
      { yPercent: -15, scale: 1.0 },
      {
        yPercent: 15,
        scale: 1.3,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      }
    );
  });

  // Fade-in en scroll para elementos de contenido
  gsap.utils.toArray<HTMLElement>('.gsap-fade').forEach((el) => {
    gsap.fromTo(el,
      { opacity: 0, y: 35 },
      {
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
        opacity: 1,
        y: 0,
        duration: 0.85,
        ease: 'power2.out',
      }
    );
  });

  // Filigranas ornamentales: se despliegan desde el centro al hacer scroll
  gsap.utils.toArray<HTMLElement>('.gsap-filigrana').forEach((el) => {
    gsap.fromTo(el,
      { opacity: 0, scaleX: 0 },
      {
        opacity: 1,
        scaleX: 1,
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 90%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector((anchor as HTMLAnchorElement).getAttribute('href')!);
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
