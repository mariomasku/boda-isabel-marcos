---
export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Isabel &amp; Marcos · El lado oscuro</title>
  <meta name="description" content="Hace mucho tiempo, en un cortijo muy, muy lejano..." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style is:global>
    @font-face {
      font-family: 'StarJedi';
      src: url('/fonts/StarJedi.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ds-bg:        #17171a; /* gris muy oscuro, no negro */
      --ds-bg-2:      #0e0e10;
      --ds-white:     #ffffff;
      --ds-yellow:    #ffe81f;
      --ds-yellow-dim: color-mix(in srgb, #ffe81f 55%, transparent);
    }

    html { scroll-behavior: auto; }

    body {
      background: var(--ds-bg);
      color: var(--ds-white);
      font-family: 'Lato', sans-serif;
      overflow-x: hidden;
    }

    /* ── Botones flotantes (volver / audio) ── */
    .ds-float-btn {
      position: fixed;
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: color-mix(in srgb, var(--ds-bg-2) 55%, transparent);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 35%, transparent);
      color: var(--ds-yellow);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .ds-float-btn:hover { background: color-mix(in srgb, var(--ds-yellow) 12%, transparent); }
    .ds-float-btn:active { transform: scale(0.95); }

    .ds-back-btn {
      top: 1.25rem;
      left: 1.25rem;
      padding: 0.55rem 1rem;
      border-radius: 20px;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .ds-audio-btn {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 48px;
      height: 48px;
      border-radius: 50%;
    }

    /* ── Hero ── */
    .ds-hero {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .ds-hero-bg {
      position: absolute;
      inset: -10% 0;
      background-image: url('/fotos/foto1-darkside.webp');
      background-size: cover;
      background-position: center;
      will-change: transform;
    }
    .ds-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        color-mix(in srgb, var(--ds-bg-2) 78%, transparent) 0%,
        color-mix(in srgb, var(--ds-bg) 55%, transparent) 50%,
        color-mix(in srgb, var(--ds-bg-2) 82%, transparent) 100%
      );
    }
    .ds-hero-content {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.3rem;
    }
    .ds-hero-pre {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 2.2vw, 1.05rem);
      color: var(--ds-yellow);
      letter-spacing: 0.35em;
      text-transform: uppercase;
    }
    .ds-hero-names {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(2.3rem, 9vw, 6rem);
      color: var(--ds-white);
      line-height: 1.15;
      text-transform: lowercase;
      text-shadow: 0 0 18px color-mix(in srgb, var(--ds-white) 35%, transparent);
    }
    .ds-hero-date {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }
    .ds-hero-date-line { width: 50px; height: 1px; background: var(--ds-yellow); }
    .ds-hero-date-text {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      letter-spacing: 0.35em;
      font-size: clamp(0.8rem, 2vw, 1rem);
      color: var(--ds-yellow);
    }
    .ds-hero-place {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      letter-spacing: 0.15em;
      font-size: clamp(0.75rem, 1.8vw, 0.95rem);
      color: var(--ds-yellow-dim);
      text-transform: uppercase;
    }

    .ds-countdown {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .ds-countdown-item { display: flex; flex-direction: column; align-items: center; min-width: 62px; }
    .ds-countdown-number {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(1.5rem, 5vw, 2.4rem);
      color: var(--ds-white);
      line-height: 1;
    }
    .ds-countdown-label {
      font-size: 0.58rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ds-yellow);
      margin-top: 0.3rem;
    }
    .ds-countdown-sep { font-family: 'StarJedi', sans-serif; font-size: 1.4rem; color: var(--ds-yellow); opacity: 0.6; margin-bottom: 1rem; }

    .ds-hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: var(--ds-yellow-dim);
      font-size: 0.62rem;
      letter-spacing: 0.3em;
      text-transform: lowcase;
      z-index: 1;
    }
    .ds-scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, var(--ds-yellow), transparent);
      animation: dsScrollPulse 2s ease-in-out infinite;
    }
    @keyframes dsScrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.1); }
    }

    /* ── Crawl (bloque "details" tematizado) ── */
    .ds-crawl-section {
      position: relative;
      height: 480vh;
      background: var(--ds-bg-2);
    }
    .ds-crawl-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    .ds-crawl-bg {
      position: absolute;
      inset: 0;
      background-image: url('/img/universe.webp');
      background-size: cover;
      background-position: center;
    }
    .ds-crawl-viewport {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .ds-crawl-text {
      position: absolute;
      top: 100%;
      left: 50%;
      width: 88%;
      max-width: 760px;
      transform: translateX(-50%) scale(1);
      transform-origin: 50% 0%;
      text-align: center;
      color: var(--ds-yellow);
    }
    /* Forma trapezoidal por ensanchamiento progresivo del ancho de cada
       párrafo (estrecho arriba/título → ancho abajo/cierre), en vez de
       recortar el texto ya compuesto: cada línea se ajusta (wrap) dentro
       de su propia anchura, sin cortar ningún carácter y sin giro 3D. */
    .ds-crawl-text p { margin: 0 auto 2.2rem; }
    .ds-crawl-text .cw-1 { max-width: 48%; }
    .ds-crawl-text .cw-2 { max-width: 62%; }
    .ds-crawl-text .cw-3 { max-width: 74%; }
    .ds-crawl-text .cw-4 { max-width: 86%; }
    .ds-crawl-text .cw-5 { max-width: 100%; }
    .ds-crawl-episode {
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 700;
      font-size: clamp(1rem, 2.6vw, 1.3rem);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .ds-crawl-title {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(1.8rem, 6vw, 3.2rem);
      letter-spacing: 0.05em;
      margin-bottom: 2.5rem;
    }
    .ds-crawl-text p {
      font-family: 'Arial Black', Arial, Helvetica, sans-serif;
      font-weight: 900;
      -webkit-text-stroke: 0.6px currentColor;
      text-transform: uppercase;
      font-size: clamp(1rem, 2.6vw, 1.5rem);
      line-height: 1.9;
      letter-spacing: 0.02em;
      margin-bottom: 2.2rem;
    }
    .ds-crawl-final {
      font-family: 'Arial Black', Arial, Helvetica, sans-serif;
      font-weight: 900;
      -webkit-text-stroke: 0.6px currentColor;
      font-size: clamp(1.4rem, 4vw, 2.2rem) !important;
      letter-spacing: 0.15em !important;
      margin-top: 1rem;
    }
    .ds-crawl-fade-top {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 42%;
      background: linear-gradient(to bottom, var(--ds-bg-2) 0%, var(--ds-bg-2) 15%, transparent 100%);
      z-index: 3;
      pointer-events: none;
    }
    .ds-crawl-fade-bottom {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 18%;
      background: linear-gradient(to top, var(--ds-bg-2) 0%, transparent 100%);
      z-index: 3;
      pointer-events: none;
    }

    /* ── Sección mapa (tras el crawl) ── */
    .ds-map-section {
      background: var(--ds-bg);
      padding: 5rem 1.5rem 6rem;
      text-align: center;
    }
    .ds-map-pre {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      font-size: clamp(0.8rem, 2vw, 0.95rem);
      color: var(--ds-yellow);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }
    .ds-map-title {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(1.6rem, 4.5vw, 2.4rem);
      color: var(--ds-white);
      margin-bottom: 2.5rem;
    }
    .ds-map-wrap {
      max-width: 900px;
      margin: 0 auto;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 30%, transparent);
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    .ds-map-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 1.1rem;
      background: var(--ds-bg-2);
      border-bottom: 1px solid color-mix(in srgb, var(--ds-yellow) 25%, transparent);
      font-size: 0.82rem;
      color: var(--ds-yellow-dim);
    }
    .ds-map-open {
      color: var(--ds-yellow);
      text-decoration: none;
      font-size: 0.78rem;
    }
    .ds-map-open:hover { text-decoration: underline; }
    .ds-map-wrap iframe {
      display: block;
      filter: grayscale(60%) invert(92%) contrast(90%);
    }

    @media (max-width: 480px) {
      .ds-crawl-section { height: 420vh; }
    }
  </style>
</head>
<body>

  <a href="/" class="ds-float-btn ds-back-btn">← Volver al lado luminoso</a>

  <button type="button" class="ds-float-btn ds-audio-btn" id="audio-toggle" aria-label="Silenciar música">
    <svg id="icon-sound-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="4,9 8,9 12,5 12,19 8,15 4,15" fill="currentColor" stroke="none"/>
      <path d="M16 8a5 5 0 0 1 0 8"/>
      <path d="M18.5 5.5a9 9 0 0 1 0 13"/>
    </svg>
    <svg id="icon-sound-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none">
      <polygon points="4,9 8,9 12,5 12,19 8,15 4,15" fill="currentColor" stroke="none"/>
      <line x1="16" y1="8" x2="21" y2="15"/>
      <line x1="21" y1="8" x2="16" y2="15"/>
    </svg>
  </button>

  <audio id="theme-audio" src="/audio/main-theme.ogg" loop preload="auto"></audio>

  <!-- ── Hero ── -->
  <section class="ds-hero">
    <div class="ds-hero-bg parallax-hero-bg"></div>
    <div class="ds-hero-overlay"></div>
    <div class="ds-hero-content">
      <p class="ds-hero-pre">nos casamos</p>
      <h1 class="ds-hero-names">isabel<br>&amp; Marcos</h1>
      <div class="ds-hero-date">
        <span class="ds-hero-date-line"></span>
        <span class="ds-hero-date-text">03 · 10 · 2026</span>
        <span class="ds-hero-date-line"></span>
      </div>
      <p class="ds-hero-place">Cortijo El Alamillo · Villarrubia, Córdoba</p>

      <div class="ds-countdown" id="ds-countdown">
        <div class="ds-countdown-item">
          <span class="ds-countdown-number" id="ds-cd-days">--</span>
          <span class="ds-countdown-label">días</span>
        </div>
        <div class="ds-countdown-sep">:</div>
        <div class="ds-countdown-item">
          <span class="ds-countdown-number" id="ds-cd-hours">--</span>
          <span class="ds-countdown-label">horas</span>
        </div>
        <div class="ds-countdown-sep">:</div>
        <div class="ds-countdown-item">
          <span class="ds-countdown-number" id="ds-cd-minutes">--</span>
          <span class="ds-countdown-label">min</span>
        </div>
        <div class="ds-countdown-sep">:</div>
        <div class="ds-countdown-item">
          <span class="ds-countdown-number" id="ds-cd-seconds">--</span>
          <span class="ds-countdown-label">seg</span>
        </div>
      </div>
    </div>

    <div class="ds-hero-scroll">
      <span>Desliza hacia arriba</span>
      <div class="ds-scroll-line"></div>
    </div>
  </section>

  <!-- ── Crawl (details tematizado) ── -->
  <section class="ds-crawl-section" id="crawl-section">
    <div class="ds-crawl-sticky">
      <div class="ds-crawl-bg"></div>
      <div class="ds-crawl-viewport">
        <div class="ds-crawl-text" id="crawl-text">
          <p class="ds-crawl-episode">Episodio I</p>
          <h2 class="ds-crawl-title">El gran día</h2>
          <p class="cw-1">
            En un universo inmenso, donde millones de caminos nacen y
            desaparecen cada segundo, hay encuentros que desafían
            cualquier probabilidad.
          </p>
          <p class="cw-2">
            Historias destinadas a cruzarse. Corazones destinados a
            encontrarse. Y personas destinadas a formar parte de algo
            mucho más grande que ellas mismas.
          </p>
          <p class="cw-3">
            Durante años hemos recorrido nuestro propio viaje. Hemos
            superado obstáculos, celebrado victorias y descubierto que
            existe una fuerza capaz de vencer cualquier distancia: el
            amor compartido con quienes hacen que la vida merezca la pena.
          </p>
          <p class="cw-4">
            Ahora llega el momento de escribir el capítulo más
            extraordinario de nuestra historia. Pero ninguna aventura
            épica está completa sin la tripulación que la hizo posible.
          </p>
          <p class="cw-5">
            Por eso queremos que estés con nosotros. Da igual desde
            dónde partas o cuántos kilómetros tengas que recorrer.
            Ese día no existirán fronteras, relojes ni mapas. Solo un
            mismo destino, un mismo latido y un mismo motivo para
            celebrar.
          </p>
          <h2 class="ds-crawl-title">
            Bienvenido al comienzo de nuestra historia.
          </h2>
        </div>
      </div>
      <div class="ds-crawl-fade-top"></div>
      <div class="ds-crawl-fade-bottom"></div>
    </div>
  </section>

  <!-- ── Mapa ── -->
  <section class="ds-map-section">
    <p class="ds-map-pre">Coordenadas de aterrizaje</p>
    <h2 class="ds-map-title">Cómo llegar</h2>
    <div class="ds-map-wrap">
      <div class="ds-map-label">
        <span>📍 Cortijo El Alamillo · Villarrubia, Córdoba</span>
        <a href="https://share.google/S2dETBj80LCp9TyRZ" target="_blank" rel="noopener" class="ds-map-open">Abrir en Google Maps →</a>
      </div>
      <iframe
        title="Localización del Cortijo El Alamillo"
        src="https://maps.google.com/maps?q=Cortijo+El+Alamillo,+Villarrubia,+Córdoba,+Spain&output=embed&z=14"
        width="100%"
        height="400"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Audio: autoplay + botón de silencio
    const audio      = document.getElementById('theme-audio') as HTMLAudioElement;
    const audioBtn    = document.getElementById('audio-toggle')!;
    const iconOn      = document.getElementById('icon-sound-on')!;
    const iconOff     = document.getElementById('icon-sound-off')!;

    function setIcon(playing: boolean) {
      iconOn.style.display  = playing ? 'block' : 'none';
      iconOff.style.display = playing ? 'none'  : 'block';
    }

    function startAudio() {
      audio.volume = 0.5;
      audio.play()
        .then(() => setIcon(true))
        .catch(() => setIcon(false));
    }

    // Intenta autoplay inmediatamente
    startAudio();

    // Si el usuario interactúa con la página antes del autoplay, vuelve a intentar
    const startAudioOnce = () => {
      startAudio();
      document.removeEventListener('click', startAudioOnce);
      document.removeEventListener('scroll', startAudioOnce);
      document.removeEventListener('touchstart', startAudioOnce);
    };
    document.addEventListener('click', startAudioOnce);
    document.addEventListener('scroll', startAudioOnce);
    document.addEventListener('touchstart', startAudioOnce);

    audioBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().then(() => setIcon(true)).catch(() => {});
      } else {
        audio.pause();
        setIcon(false);
      }
    });

    // Animación del hero: letras suben suavemente + imagen fade out
    gsap.set('.ds-hero-content', { y: 0, opacity: 1 });
    gsap.to('.ds-hero-content', {
      y: -120,
      opacity: 0.3,
      ease: 'power2.inOut',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'center top',
        scrub: 1.2,
      },
    });

    // Fade out de la imagen del hero
    gsap.to('.ds-hero-bg', {
      opacity: 0,
      ease: 'power2.inOut',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1.2,
      },
    });

    // Parallax suave del hero (todavía mantiene movimiento suave)
    gsap.to('.parallax-hero-bg', {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    // Parallax del fondo universe hacia abajo
    gsap.to('.ds-crawl-bg', {
      yPercent: -25,
      ease: 'none',
      scrollTrigger: {
        trigger: '.ds-crawl-section',
        start: 'top center',
        end: 'bottom center',
        scrub: 1,
      },
    });

    // Crawl: el texto sube desde abajo (top:100%) y se va encogiendo
    // (scale) a la vez, sin ningún giro 3D. La máscara .ds-crawl-viewport
    // (clip-path trapezoidal) recorta el texto en un embudo, y el
    // degradado .ds-crawl-fade-top lo hace desaparecer del todo al pasar
    // el 15% superior de la pantalla.
    gsap.set('#crawl-text', { top: '100%', scale: 1 });
    gsap.to('#crawl-text', {
      top: '-30%',
      scale: 0.18,
      ease: 'none',
      scrollTrigger: {
        trigger: '#crawl-section',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
      },
    });

    // Cuenta atrás
    function updateCountdown() {
      const weddingDate = new Date('2026-10-03T19:00:00');
      const now = new Date();
      const diff = weddingDate.getTime() - now.getTime();

      if (diff <= 0) {
        document.getElementById('ds-countdown')!.innerHTML =
          '<p style="color:var(--ds-yellow);font-family:\'StarJedi\',sans-serif;font-size:1.2rem;">¡Hoy es el gran día!</p>';
        return;
      }

      const days    = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      const pad = (n: number) => String(n).padStart(2, '0');

      document.getElementById('ds-cd-days')!.textContent    = String(days);
      document.getElementById('ds-cd-hours')!.textContent   = pad(hours);
      document.getElementById('ds-cd-minutes')!.textContent = pad(minutes);
      document.getElementById('ds-cd-seconds')!.textContent = pad(seconds);
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
