  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';
    gsap.registerPlugin(ScrollTrigger, SplitText);

    // Audio: autoplay + botón de silencio
    const audio      = document.getElementById('theme-audio') as HTMLAudioElement;
    const audioBtn    = document.getElementById('audio-toggle')!;
    const iconOn      = document.getElementById('icon-sound-on')!;
    const iconOff     = document.getElementById('icon-sound-off')!;

    function setIcon(playing: boolean) {
      iconOn.style.display  = playing ? 'block' : 'none';
      iconOff.style.display = playing ? 'none'  : 'block';
    }

    function startAudio() {
      audio.volume = 0.5;
      audio.play()
        .then(() => setIcon(true))
        .catch(() => setIcon(false));
    }

    // Intenta autoplay inmediatamente
    startAudio();

    // Si el usuario interactúa con la página antes del autoplay, vuelve a intentar
    const startAudioOnce = () => {
      startAudio();
      document.removeEventListener('click', startAudioOnce);
      document.removeEventListener('scroll', startAudioOnce);
      document.removeEventListener('touchstart', startAudioOnce);
    };
    document.addEventListener('click', startAudioOnce);
    document.addEventListener('scroll', startAudioOnce);
    document.addEventListener('touchstart', startAudioOnce);

    audioBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().then(() => setIcon(true)).catch(() => {});
      } else {
        audio.pause();
        setIcon(false);
      }
    });

    // Animación del hero: letras suben suavemente + imagen fade out
    gsap.set('.ds-hero-content', { y: 0, opacity: 1 });
    gsap.to('.ds-hero-content', {
      y: -120,
      opacity: 0.3,
      ease: 'power2.inOut',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'center top',
        scrub: 1.2,
      },
    });

    // Fade out de la imagen del hero
    gsap.to('.ds-hero-bg', {
      opacity: 0,
      ease: 'power2.inOut',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1.2,
      },
    });

    // Parallax suave del hero (todavía mantiene movimiento suave)
    gsap.to('.parallax-hero-bg', {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: '.ds-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    // Parallax del fondo universe: el fondo mide un 130% de alto y empieza
    // encuadrado por arriba (background-position: top), así que al
    // desplazarlo hacia arriba un 23% de su propia altura (= el 30% extra
    // que sobresale por abajo) se recorre toda la imagen de arriba a abajo
    // sin que en ningún momento se vea recortada ni aparezca hueco vacío.
    gsap.to('.ds-crawl-bg', {
      yPercent: -23,
      ease: 'none',
      scrollTrigger: {
        trigger: '.ds-crawl-section',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
      },
    });

    // Cada LÍNEA del crawl (no cada párrafo entero) escala según SU PROPIA
    // posición real en pantalla, para que todas aparezcan desde abajo con
    // el mismo tamaño grande y solo se encojan, una a una, al acercarse a
    // la zona de desvanecido superior. GSAP SplitText divide el texto en
    // líneas reales (respeta el wrap actual del navegador).
    const crawlTextEl = document.getElementById('crawl-text') as HTMLElement;
    const crawlBlocks = Array.from(crawlTextEl.children) as HTMLElement[];
    const CRAWL_SHRINK_ZONE = 0.6; // el encogido empieza al 60% de la pantalla (más abajo)
    const CRAWL_MIN_SCALE = 0.35;
    let crawlLines: HTMLElement[] = [];
    let crawlTween: gsap.core.Tween | null = null;
    const crawlBlockLines = new Map<HTMLElement, HTMLElement[]>();

    function updateCrawlLineScales() {
      const shrinkStart = window.innerHeight * CRAWL_SHRINK_ZONE;
      crawlLines.forEach((el) => {
        const top = el.getBoundingClientRect().top;
        let scale = 1;
        if (top <= 0) {
          scale = CRAWL_MIN_SCALE;
        } else if (top < shrinkStart) {
          const progress = top / shrinkStart;
          scale = CRAWL_MIN_SCALE + (1 - CRAWL_MIN_SCALE) * progress;
        }
        el.style.transform = `scale(${scale})`;
      });
    }

    // El recorrido del scroll se calcula según la altura REAL del texto
    // (que cambia con el tamaño de fuente y el ancho de pantalla), en vez
    // de un porcentaje fijo. Así el bloque siempre sube lo suficiente para
    // que la última línea llegue a pasar por completo, sin quedarse ningún
    // párrafo oculto por debajo de la zona visible.
    function rebuildCrawlScroll() {
      crawlTween?.scrollTrigger?.kill();
      crawlTween?.kill();

      gsap.set('#crawl-text', { top: '100%' });
      const contentHeight = crawlTextEl.scrollHeight;

      crawlTween = gsap.to('#crawl-text', {
        top: -(contentHeight + 80) + 'px',
        ease: 'none',
        // onUpdate va en el tween (no en el scrollTrigger): con scrub:1 el
        // movimiento sigue suavizándose ~1s después de dejar de hacer
        // scroll, y solo el onUpdate del propio tween se dispara en cada
        // uno de esos fotogramas de "coasting" (el onUpdate del
        // scrollTrigger solo se dispara con eventos de scroll reales).
        onUpdate: updateCrawlLineScales,
        scrollTrigger: {
          trigger: '#crawl-section',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
          onRefresh: updateCrawlLineScales,
        },
      });
    }

    // Cada bloque original (párrafo o título) se divide en líneas por
    // separado: así sabemos cuál es la ÚLTIMA línea de cada párrafo real
    // y solo a esa le añadimos separación (el resto de líneas queda
    // pegado, sin espacio extra entre ellas).
    crawlBlocks.forEach((block) => {
      new SplitText(block, {
        type: 'lines',
        linesClass: 'crawl-line',
        autoSplit: true,
        onSplit(self) {
          const lines = self.lines as HTMLElement[];
          lines.forEach((line, i) => {
            line.classList.toggle('crawl-line-last', i === lines.length - 1);
          });
          crawlBlockLines.set(block, lines);
          crawlLines = crawlBlocks.flatMap((b) => crawlBlockLines.get(b) ?? []);
          rebuildCrawlScroll();
          ScrollTrigger.refresh();
        },
      });
    });

    // Fade-in genérico al hacer scroll, para el resto de secciones
    gsap.utils.toArray<HTMLElement>('.ds-fade').forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 35 },
        {
          scrollTrigger: {
            trigger: el,
            start: 'top 88%',
            toggleActions: 'play none none none',
          },
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power2.out',
        }
      );
    });

    // Itinerario: cada ítem entra desde los lados
    gsap.utils.toArray<HTMLElement>('.ds-tl-item').forEach((item) => {
      const left  = item.querySelector<HTMLElement>('.ds-tl-left');
      const right = item.querySelector<HTMLElement>('.ds-tl-right');

      gsap.set(item, { opacity: 0 });
      if (left)  gsap.set(left,  { x: -18, opacity: 0 });
      if (right) gsap.set(right, { x:  18, opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: 'top 86%',
          toggleActions: 'play none none reverse',
        },
      });

      tl.to(item,  { opacity: 1, duration: 0.01 })
        .to(left,  { x: 0, opacity: 1, duration: 0.45, ease: 'power2.out' }, 0)
        .to(right, { x: 0, opacity: 1, duration: 0.45, ease: 'power2.out' }, 0.1);
    });

    // Fotos parallax intermedias
    gsap.utils.toArray<HTMLElement>('.ds-photo-section').forEach((section) => {
      const bg = section.querySelector<HTMLElement>('.ds-photo-bg');
      if (!bg) return;
      gsap.fromTo(bg,
        { yPercent: -15, scale: 1.0 },
        {
          yPercent: 15,
          scale: 1.3,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    });

    // Autobús: tarjetas entran desde arriba/lados
    gsap.fromTo('.ds-bus-ida-wrap .ds-bus-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.ds-bus-ida-wrap',
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
      }
    );

    gsap.utils.toArray<HTMLElement>('.ds-bus-routes .ds-bus-card').forEach((card, i) => {
      gsap.fromTo(card,
        { opacity: 0, x: i === 0 ? -50 : 50 },
        {
          opacity: 1,
          x: 0,
          duration: 0.7,
          delay: i === 1 ? 0.15 : 0,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.ds-bus-routes',
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        }
      );
    });

    // Cuenta atrás
    function updateCountdown() {
      const weddingDate = new Date('2026-10-03T19:00:00');
      const now = new Date();
      const diff = weddingDate.getTime() - now.getTime();

      if (diff <= 0) {
        document.getElementById('ds-countdown')!.innerHTML =
          '<p style="color:var(--ds-yellow);font-family:\'StarJedi\',sans-serif;font-size:1.2rem;">¡Hoy es el gran día!</p>';
        return;
      }

      const days    = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      const pad = (n: number) => String(n).padStart(2, '0');

      document.getElementById('ds-cd-days')!.textContent    = String(days);
      document.getElementById('ds-cd-hours')!.textContent   = pad(hours);
      document.getElementById('ds-cd-minutes')!.textContent = pad(minutes);
      document.getElementById('ds-cd-seconds')!.textContent = pad(seconds);
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>

  <!-- ── Lógica del formulario RSVP (idéntica a la versión clara) ── -->
  <script>
    const extrasSi = document.getElementById('ds-extras-si')!;
    document.querySelectorAll<HTMLInputElement>('#ds-rsvp-form input[name="asistencia"]').forEach((el) => {
      el.addEventListener('change', () => {
        const asiste = el.value.startsWith('Sí');
        extrasSi.classList.toggle('visible', asiste);
        if (!asiste) {
          (document.getElementById('ds-acomp-nombre-block') as HTMLElement).style.display = 'none';
          (document.getElementById('ds-ninos-block') as HTMLElement).style.display = 'none';
          resetNinosCount();
          (document.getElementById('ds-bus-plazas-block') as HTMLElement).style.display = 'none';
          document.querySelectorAll<HTMLInputElement>('#ds-extras-si input[type="radio"], #ds-extras-si input[type="checkbox"]')
            .forEach(i => { i.checked = false; });
          resetIntolerancias();
        }
      });
    });

    const acSi    = document.getElementById('ds-acomp-si') as HTMLInputElement;
    const acNo    = document.getElementById('ds-acomp-no') as HTMLInputElement;
    const acBlock = document.getElementById('ds-acomp-nombre-block')!;
    acSi?.addEventListener('change', () => { acBlock.style.display = 'block'; refreshIntolList(); buildBusPlazasBtns(); });
    acNo?.addEventListener('change', () => { acBlock.style.display = 'none';  refreshIntolList(); buildBusPlazasBtns(); });

    const ninosSi    = document.getElementById('ds-ninos-si') as HTMLInputElement;
    const ninosNo    = document.getElementById('ds-ninos-no') as HTMLInputElement;
    const ninosBlock = document.getElementById('ds-ninos-block')!;
    ninosSi?.addEventListener('change', () => { ninosBlock.style.display = 'flex'; refreshIntolList(); });
    ninosNo?.addEventListener('change', () => {
      ninosBlock.style.display = 'none';
      resetNinosCount();
      refreshIntolList();
    });

    function buildNinoFields(count: number) {
      const container = document.getElementById('ds-ninos-names-container')!;
      container.innerHTML = '';
      for (let i = 1; i <= count; i++) {
        const group = document.createElement('div');
        group.className = 'ds-nino-entry';
        group.innerHTML = `
          <span class="ds-nino-entry-title">Niño/a ${i}</span>
          <span class="ds-nino-campo-label">Nombre</span>
          <input type="text" name="nino_${i}_nombre" id="ds-nino_${i}_nombre" placeholder="Nombre completo" required />
          <span class="ds-nino-campo-label">Edad</span>
          <input type="number" name="nino_${i}_edad" placeholder="Años (0–17)" min="0" max="17" required />
        `;
        container.appendChild(group);
        document.getElementById(`ds-nino_${i}_nombre`)?.addEventListener('input', refreshIntolList);
      }
      refreshIntolList();
    }

    function resetNinosCount() {
      document.querySelectorAll<HTMLButtonElement>('#ds-ninos-count-picker .ds-count-btn').forEach(b => b.classList.remove('selected'));
      (document.getElementById('ds-ninos_count') as HTMLInputElement).value = '';
      document.getElementById('ds-ninos-names-container')!.innerHTML = '';
    }

    document.getElementById('ds-ninos-count-picker')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ds-count-btn');
      if (!btn) return;
      const val = btn.dataset.value ?? '';
      document.querySelectorAll<HTMLButtonElement>('#ds-ninos-count-picker .ds-count-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      (document.getElementById('ds-ninos_count') as HTMLInputElement).value = val;
      buildNinoFields(parseInt(val) || 0);
      buildBusPlazasBtns();
    });

    function getTotalPersonas(): number {
      let total = 1;
      if ((document.getElementById('ds-acomp-si') as HTMLInputElement)?.checked) total += 1;
      total += parseInt((document.getElementById('ds-ninos_count') as HTMLInputElement)?.value || '0') || 0;
      return total;
    }

    function buildBusPlazasBtns() {
      const picker  = document.getElementById('ds-bus-plazas-picker')!;
      const hidden  = document.getElementById('ds-bus_plazas') as HTMLInputElement;
      const current = hidden?.value ?? '';
      const total   = getTotalPersonas();
      picker.innerHTML = '';
      for (let i = 1; i <= total; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ds-count-btn' + (String(i) === current ? ' selected' : '');
        btn.dataset.value = String(i);
        btn.textContent = String(i);
        picker.appendChild(btn);
      }
      if (current && parseInt(current) > total) hidden.value = '';
    }

    document.getElementById('ds-bus-plazas-picker')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ds-count-btn');
      if (!btn) return;
      const val = btn.dataset.value ?? '';
      document.querySelectorAll<HTMLButtonElement>('#ds-bus-plazas-picker .ds-count-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      (document.getElementById('ds-bus_plazas') as HTMLInputElement).value = val;
    });

    const busPlazasBlock = document.getElementById('ds-bus-plazas-block')!;
    document.querySelectorAll('#ds-rsvp-form input[name="autobus"]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val !== 'No lo necesitaré') {
          busPlazasBlock.style.display = 'flex';
          buildBusPlazasBtns();
        } else {
          busPlazasBlock.style.display = 'none';
          (document.getElementById('ds-bus_plazas') as HTMLInputElement).value = '';
        }
      });
    });

    const INTOL_ITEMS: [string, string][] = [
      ['GLUTEN',       'Gluten (celiaquía o sensibilidad al gluten)'],
      ['LACTOSA',      'Lactosa / lácteos'],
      ['HUEVO',        'Huevo'],
      ['FRUTOS_SECOS', 'Frutos secos (almendras, nueces, avellanas, etc.)'],
      ['CACAHUETE',    'Cacahuete'],
      ['MARISCO',      'Marisco'],
      ['PESCADO',      'Pescado'],
      ['SOJA',         'Soja'],
      ['SESAMO',       'Sésamo'],
      ['MOSTAZA',      'Mostaza'],
      ['APIO',         'Apio'],
      ['SULFITOS',     'Sulfitos (vino, frutos secos tratados, etc.)'],
      ['ALTRAMUCES',   'Altramuces (lupino)'],
      ['MOLUSCOS',     'Moluscos (mejillones, almejas, pulpo, calamar, etc.)'],
    ];

    function getGroupPersons() {
      const persons: { id: string; nombre: string; badge: string }[] = [];
      const nombreInv = (document.getElementById('ds-nombre') as HTMLInputElement)?.value?.trim() || 'Tú';
      persons.push({ id: 'invitado', nombre: nombreInv, badge: 'Invitado/a' });
      if ((document.getElementById('ds-acomp-si') as HTMLInputElement)?.checked) {
        const acN = (document.getElementById('ds-acompanante_nombre') as HTMLInputElement)?.value?.trim() || 'Acompañante';
        persons.push({ id: 'acompanante', nombre: acN, badge: 'Acompañante' });
      }
      if ((document.getElementById('ds-ninos-si') as HTMLInputElement)?.checked) {
        const cnt = parseInt((document.getElementById('ds-ninos_count') as HTMLSelectElement)?.value) || 0;
        for (let i = 1; i <= cnt; i++) {
          const nn = (document.getElementById(`ds-nino_${i}_nombre`) as HTMLInputElement)?.value?.trim() || `Niño/a ${i}`;
          persons.push({ id: `nino_${i}`, nombre: nn, badge: 'Niño/a' });
        }
      }
      return persons;
    }

    function buildCheckboxGrid(personId: string) {
      return `<div class="ds-intol-checkboxes">
        ${INTOL_ITEMS.map(([val, label]) =>
          `<label class="ds-intol-check-label"><input type="checkbox" name="intol_${personId}" value="${val}" />${label}</label>`
        ).join('')}
      </div>
      <div class="ds-intol-otros-wrap">
        <span class="ds-intol-otros-label">Otros:</span>
        <input type="text" name="intol_${personId}_otros" placeholder="Especifica otros alérgenos..." />
      </div>`;
    }

    function saveIntolSelections() {
      const saved: Record<string, string[]> = {};
      document.querySelectorAll<HTMLInputElement>('#ds-rsvp-form [name^="intol_"]').forEach(el => {
        if (el.type === 'checkbox' && el.checked) (saved[el.name] ??= []).push(el.value);
        else if (el.type === 'text' && el.value)   saved[el.name] = [el.value];
      });
      return saved;
    }

    function restoreIntolSelections(saved: Record<string, string[]>) {
      Object.entries(saved).forEach(([name, values]) => {
        document.querySelectorAll<HTMLInputElement>(`#ds-rsvp-form [name="${name}"]`).forEach(el => {
          if (el.type === 'checkbox') el.checked = values.includes(el.value);
          else if (el.type === 'text') el.value = values[0] ?? '';
        });
      });
    }

    function updateCountBadge(personId: string) {
      const count = document.querySelectorAll<HTMLInputElement>(`input[name="intol_${personId}"]:checked`).length;
      const badge = document.querySelector<HTMLElement>(`#ds-intol-card-${personId} .ds-intol-count`);
      if (!badge) return;
      badge.textContent = count > 0 ? `${count} seleccionada${count !== 1 ? 's' : ''}` : '';
      badge.classList.toggle('visible', count > 0);
    }

    function refreshIntolList() {
      if (!(document.getElementById('ds-intol-si') as HTMLInputElement)?.checked) return;
      const saved   = saveIntolSelections();
      const persons = getGroupPersons();
      const list    = document.getElementById('ds-intol-personas-list')!;
      list.innerHTML = persons.map(p => `
        <div class="ds-intol-person-card" id="ds-intol-card-${p.id}">
          <button type="button" class="ds-intol-person-btn" data-pid="${p.id}">
            <span class="ds-intol-person-name">${p.nombre}</span>
            <span class="ds-intol-person-badge">${p.badge}</span>
            <span class="ds-intol-count"></span>
            <span class="ds-intol-chevron">▼</span>
          </button>
          <div class="ds-intol-panel">${buildCheckboxGrid(p.id)}</div>
        </div>`).join('');

      list.querySelectorAll<HTMLButtonElement>('.ds-intol-person-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card   = btn.closest('.ds-intol-person-card')!;
          const isOpen = card.classList.contains('open');
          list.querySelectorAll('.ds-intol-person-card').forEach(c => c.classList.remove('open'));
          if (!isOpen) card.classList.add('open');
        });
      });
      list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(cb => {
        const pid = cb.name.replace('intol_', '');
        cb.addEventListener('change', () => updateCountBadge(pid));
      });

      restoreIntolSelections(saved);
      persons.forEach(p => updateCountBadge(p.id));
    }

    function resetIntolerancias() {
      (document.getElementById('ds-intol-no') as HTMLInputElement).checked = false;
      (document.getElementById('ds-intol-si') as HTMLInputElement).checked = false;
      document.getElementById('ds-intol-personas-wrap')!.style.display = 'none';
      document.getElementById('ds-intol-personas-list')!.innerHTML = '';
      (document.getElementById('ds-intol-error') as HTMLElement).style.display = 'none';
    }

    document.getElementById('ds-email')?.addEventListener('input', () => {
      (document.getElementById('ds-email-error') as HTMLElement).style.display = 'none';
    });

    document.getElementById('ds-intol-si')?.addEventListener('change', () => {
      document.getElementById('ds-intol-personas-wrap')!.style.display = 'block';
      document.getElementById('ds-intol-error')!.style.display = 'none';
      refreshIntolList();
    });
    document.getElementById('ds-intol-no')?.addEventListener('change', () => {
      document.getElementById('ds-intol-personas-wrap')!.style.display = 'none';
      document.getElementById('ds-intol-error')!.style.display = 'none';
    });

    document.getElementById('ds-nombre')?.addEventListener('input', refreshIntolList);
    document.getElementById('ds-acompanante_nombre')?.addEventListener('input', refreshIntolList);

    const successOverlay = document.getElementById('ds-success-overlay') as HTMLElement;

    function openSuccessModal() {
      successOverlay.style.display = 'flex';
      successOverlay.getBoundingClientRect();
      successOverlay.classList.add('open');
    }

    function closeSuccessModal() {
      successOverlay.classList.remove('open');
      successOverlay.addEventListener('transitionend', () => {
        successOverlay.style.display = 'none';
      }, { once: true });
    }

    document.getElementById('ds-success-accept')?.addEventListener('click', closeSuccessModal);
    successOverlay.addEventListener('click', (e) => { if (e.target === successOverlay) closeSuccessModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && successOverlay.classList.contains('open')) closeSuccessModal(); });

    const form = document.getElementById('ds-rsvp-form') as HTMLFormElement;
    const errorMsg   = document.getElementById('ds-form-error')!;

    function resetFormCompleto() {
      form.reset();
      extrasSi.classList.remove('visible');
      (document.getElementById('ds-acomp-nombre-block') as HTMLElement).style.display = 'none';
      (document.getElementById('ds-ninos-block') as HTMLElement).style.display = 'none';
      (document.getElementById('ds-bus-plazas-block') as HTMLElement).style.display = 'none';
      resetNinosCount();
      resetIntolerancias();
      (document.getElementById('ds-email-error') as HTMLElement).style.display = 'none';
      document.getElementById('ds-bus-plazas-picker')!.innerHTML = '';
      (document.getElementById('ds-bus_plazas') as HTMLInputElement).value = '';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.ds-submit-btn') as HTMLButtonElement;

      const asiste = form.querySelector<HTMLInputElement>('input[name="asistencia"]:checked')?.value?.startsWith('Sí');
      if (asiste && !form.querySelector<HTMLInputElement>('input[name="tiene_intolerancias"]:checked')) {
        const errEl = document.getElementById('ds-intol-error')!;
        errEl.style.display = 'block';
        const rect = errEl.getBoundingClientRect();
        const offset = window.scrollY + rect.top - window.innerHeight / 2 + rect.height / 2;
        window.scrollTo(0, offset);
        return;
      }

      btn.textContent = 'Enviando...';
      btn.disabled = true;

      try {
        const fd = new FormData(form);
        const data: Record<string, string | string[]> = {};
        fd.forEach((value, key) => {
          const existing = data[key];
          if (existing !== undefined) {
            data[key] = Array.isArray(existing) ? [...existing, String(value)] : [existing, String(value)];
          } else {
            data[key] = String(value);
          }
        });

        const res = await fetch('/api/rsvp', {
          method: 'POST',
          body: JSON.stringify(data),
          headers: { 'Content-Type': 'application/json' },
        });

        const json = await res.json().catch(() => ({}));
        if (res.ok) {
          resetFormCompleto();
          errorMsg.style.display = 'none';
          (document.getElementById('ds-email-error') as HTMLElement).style.display = 'none';
          btn.textContent = 'Enviar confirmación';
          btn.disabled = false;
          openSuccessModal();
        } else if (res.status === 409 || json.code === 'DUPLICATE_EMAIL') {
          const emailError = document.getElementById('ds-email-error')!;
          emailError.style.display = 'block';
          const rect = emailError.getBoundingClientRect();
          const offset = window.scrollY + rect.top - window.innerHeight / 2 + rect.height / 2;
          window.scrollTo(0, offset);
          btn.textContent = 'Enviar confirmación';
          btn.disabled = false;
        } else {
          console.error('RSVP error:', json);
          throw new Error(json.error || 'unknown');
        }
      } catch (err) {
        console.error('RSVP submit error:', err);
        errorMsg.style.display = 'block';
        btn.textContent = 'Enviar confirmación';
        btn.disabled = false;
      }
    });
  </script>

  <!-- ── Acceso privado (footer) ── -->
  <script>
    const USERS: Record<string, string> = {
      marcos: '031026',
      isabel: '031026',
      admin:  '031026',
    };

    const overlay   = document.getElementById('ds-login-overlay') as HTMLElement;
    const closeBtn  = document.getElementById('ds-login-close')!;
    const lockBtn   = document.getElementById('ds-lock-btn')!;
    const loginForm = document.getElementById('ds-login-form') as HTMLFormElement;
    const userInput = document.getElementById('ds-login-user') as HTMLInputElement;
    const passInput = document.getElementById('ds-login-pass') as HTMLInputElement;
    const errorEl   = document.getElementById('ds-login-error')!;

    function openModal() {
      overlay.style.display = 'flex';
      overlay.getBoundingClientRect();
      overlay.classList.add('open');
      setTimeout(() => userInput.focus(), 80);
    }

    function closeModal() {
      overlay.classList.remove('open');
      overlay.addEventListener('transitionend', () => {
        overlay.style.display = 'none';
      }, { once: true });
    }

    lockBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const user = userInput.value.toLowerCase().trim();
      const pass = passInput.value.trim();
      if (USERS[user] !== undefined && USERS[user] === pass) {
        sessionStorage.setItem('boda_auth', 'boda031026');
        window.location.href = '/dashboard';
      } else {
        errorEl.textContent = 'Usuario o contraseña incorrectos';
        passInput.value = '';
        passInput.focus();
      }
    });
  </script>
</body>
</html>
