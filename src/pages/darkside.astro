---
export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Isabel &amp; Marcos · El lado oscuro</title>
  <meta name="description" content="Hace mucho tiempo, en un cortijo muy, muy lejano..." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style is:global>
    @font-face {
      font-family: 'StarJedi';
      src: url('/fonts/StarJedi.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'Starjhol';
      src: url('/fonts/Starjhol.ttf') format('truetype');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ds-bg:        #17171a; /* gris muy oscuro, no negro */
      --ds-bg-2:      #0e0e10;
      --ds-white:     #ffffff;
      --ds-yellow:    #ffe81f;
      --ds-yellow-dim: color-mix(in srgb, #ffe81f 55%, transparent);
    }

    html { scroll-behavior: auto; }

    body {
      background: var(--ds-bg);
      color: var(--ds-white);
      font-family: 'Lato', sans-serif;
      overflow-x: hidden;
    }

    /* ── Botones flotantes (volver / audio) ── */
    .ds-float-btn {
      position: fixed;
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: color-mix(in srgb, var(--ds-bg-2) 55%, transparent);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 35%, transparent);
      color: var(--ds-yellow);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .ds-float-btn:hover { background: color-mix(in srgb, var(--ds-yellow) 12%, transparent); }
    .ds-float-btn:active { transform: scale(0.95); }

    .ds-back-btn {
      top: 1.25rem;
      left: 1.25rem;
      padding: 0.55rem 1rem;
      border-radius: 20px;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .ds-audio-btn {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 48px;
      height: 48px;
      border-radius: 50%;
    }

    /* ── Hero ── */
    .ds-hero {
      position: relative;
      height: 100vh;
      overflow: hidden;
    }
    .ds-hero-bg {
      position: absolute;
      inset: -10% 0;
      background-image: url('/fotos/foto1-darkside.webp');
      background-size: cover;
      background-position: center;
      will-change: transform;
    }
    .ds-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        color-mix(in srgb, var(--ds-bg-2) 78%, transparent) 0%,
        color-mix(in srgb, var(--ds-bg) 55%, transparent) 50%,
        color-mix(in srgb, var(--ds-bg-2) 82%, transparent) 100%
      );
    }
    .ds-hero-content {
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    /* Bloque de texto anclado a la parte alta (deja libre el centro), igual
       que en la página principal */
    .ds-hero-top {
      position: absolute;
      top: 10%;
      left: 0;
      right: 0;
      text-align: center;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.3rem;
    }
    .ds-hero-pre {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 2.2vw, 1.05rem);
      color: var(--ds-yellow);
      letter-spacing: 0.35em;
      text-transform: uppercase;
    }
    .ds-hero-names {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(2.3rem, 9vw, 6rem);
      color: var(--ds-white);
      line-height: 1.15;
      text-transform: lowercase;
      text-shadow: 0 0 18px color-mix(in srgb, var(--ds-white) 35%, transparent);
    }
    .ds-hero-date {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      font-weight: 300;
    }
    .ds-hero-date-line { width: 50px; height: 1px; background: var(--ds-yellow); }
    .ds-hero-date-text {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      letter-spacing: 0.35em;
      font-size: clamp(0.8rem, 2vw, 1rem);
      color: var(--ds-yellow);
    }
    .ds-hero-place {
      font-family: 'Lato', sans-serif;
      font-weight: 600;
      letter-spacing: 0.15em;
      font-size: clamp(0.75rem, 1.8vw, 0.95rem);
      color: var(--ds-yellow-dim);
      text-transform: uppercase;
    }

    /* Contador anclado abajo, igual que en la página principal */
    .ds-countdown,
    .ds-hero-countdown-title {
      position: absolute;
      bottom: calc(11% + 2rem);
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .ds-hero-countdown-title { bottom: calc(18% + 2rem); }
    .ds-countdown-item { display: flex; flex-direction: column; align-items: center; min-width: 62px; }
    .ds-countdown-number {
      font-family: 'Starjhol', sans-serif;
      font-size: clamp(1.5rem, 5vw, 2.4rem);
      color: var(--ds-yellow);
      line-height: 1;
    }
    .ds-countdown-label {
      font-size: 0.58rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ds-yellow);
      margin-top: 0.3rem;
    }
    .ds-countdown-sep { font-family: 'StarJedi', sans-serif; font-size: 1.4rem; color: var(--ds-yellow); opacity: 0.6; margin-bottom: 1rem; }

    .ds-hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: var(--ds-yellow-dim);
      font-size: 0.62rem;
      letter-spacing: 0.3em;
      text-transform: lowcase;
      z-index: 1;
    }
    .ds-scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, var(--ds-yellow), transparent);
      animation: dsScrollPulse 2s ease-in-out infinite;
    }
    @keyframes dsScrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.1); }
    }

    /* ── Crawl (bloque "details" tematizado) ── */
    .ds-crawl-section {
      position: relative;
      height: 480vh;
      background: var(--ds-bg-2);
    }
    .ds-crawl-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    .ds-crawl-bg {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 130%;
      background-image: url('/img/universe.webp');
      background-size: cover;
      background-position: top center;
      will-change: transform;
    }
    .ds-crawl-viewport {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .ds-crawl-text {
      position: absolute;
      top: 100%;
      left: 50%;
      width: 88%;
      max-width: 760px;
      transform: translateX(-50%) scale(1);
      transform-origin: 50% 0%;
      text-align: center;
      color: var(--ds-yellow);
    }
    .ds-crawl-text p,
    .ds-crawl-text h2 { margin: 0; }
    /* GSAP SplitText divide cada párrafo/título en líneas (.crawl-line);
       cada línea escala de forma independiente según su posición real en
       pantalla, por eso necesita su propio origen de transformación. */
    .ds-crawl-text .crawl-line { transform-origin: 50% 0%; }

    /* Solo la ÚLTIMA línea de cada párrafo/título real lleva separación,
       para que haya espacio entre párrafos pero las líneas de un mismo
       párrafo queden pegadas entre sí. */
    .crawl-line.crawl-line-last { margin-bottom: 1.8rem; }

    .ds-crawl-episode {
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 400;
      font-size: clamp(1rem, 2.6vw, 1.3rem);
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }
    .ds-crawl-title {
      font-family: 'StarJedi', sans-serif;
      font-size: clamp(1.8rem, 6vw, 3.2rem);
      letter-spacing: 0.05em;
    }
    .ds-crawl-text p {
      font-family: 'Arial Black', Arial, Helvetica, sans-serif;
      font-weight: 900;
      -webkit-text-stroke: 0.6px currentColor;
      text-transform: uppercase;
      font-size: clamp(1.35rem, 3.6vw, 2.1rem);
      line-height: 1.75;
      letter-spacing: 0.02em;
    }
    .ds-crawl-final {
      font-family: 'Arial Black', Arial, Helvetica, sans-serif;
      font-weight: 900;
      -webkit-text-stroke: 0.6px currentColor;
      font-size: clamp(1.4rem, 4vw, 2.2rem) !important;
      letter-spacing: 0.15em !important;
    }
    .ds-crawl-fade-top {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 42%;
      background: linear-gradient(to bottom, var(--ds-bg-2) 0%, var(--ds-bg-2) 15%, transparent 100%);
      z-index: 3;
      pointer-events: none;
    }
    .ds-crawl-fade-bottom {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 18%;
      background: linear-gradient(to top, var(--ds-bg-2) 0%, transparent 100%);
      z-index: 3;
      pointer-events: none;
    }

    /* ── Utilidad: fade-in genérico al hacer scroll ── */
    .ds-fade { opacity: 0; }

    /* ── Cabeceras de sección reutilizables ── */
    .ds-section-pre {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      font-size: clamp(0.8rem, 2vw, 0.95rem);
      color: var(--ds-yellow);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
      text-align: center;
    }
    .ds-section-title {
      font-family: 'Starjhol', sans-serif;
      font-size: clamp(1.6rem, 4.5vw, 2.4rem);
      color: var(--ds-yellow);
      text-align: center;
      margin-bottom: 1rem;
      font-weight: 400;
    }

    /* ── Sección Itinerario (timeline) ── */
    .ds-timeline-section {
      background: var(--ds-bg);
      padding: 6rem 1.5rem 4rem;
    }
    .ds-timeline-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .ds-event-date {
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      letter-spacing: 0.15em;
      color: var(--ds-yellow-dim);
      font-size: clamp(0.85rem, 2vw, 1rem);
      text-transform: uppercase;
      text-align: center;
    }
    .ds-tl {
      margin: 2.5rem auto 0;
      width: 100%;
      max-width: 600px;
    }
    .ds-tl-item { display: flex; gap: 1.6rem; }
    .ds-tl-left {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      width: 64px;
    }
    .ds-tl-icon-wrap {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--ds-bg-2);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 40%, transparent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .ds-tl-icon {
      width: 32px;
      height: 32px;
      filter: invert(1) opacity(0.85);
    }
    .ds-tl-stem {
      flex: 1;
      width: 1px;
      min-height: 20px;
      background: var(--ds-yellow);
      opacity: 0.35;
      margin: 6px 0;
    }
    .ds-tl-right {
      padding-top: 0.6rem;
      padding-bottom: 1.3rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .ds-tl-time {
      font-family: 'StarJedi', sans-serif;
      font-size: 1.1rem;
      color: var(--ds-white);
      line-height: 1.3;
    }
    .ds-tl-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.74rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ds-yellow-dim);
      line-height: 1.6;
      margin: 0;
    }
    .ds-tl-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      color: var(--ds-yellow);
      text-decoration: none;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border-bottom: 1px solid color-mix(in srgb, var(--ds-yellow) 40%, transparent);
      padding-bottom: 1px;
      margin-top: 0.3rem;
      width: fit-content;
    }
    .ds-tl-link:hover { color: var(--ds-white); }

    /* ── Sección mapa (tras el itinerario) ── */
    .ds-map-section {
      background: var(--ds-bg);
      padding: 1rem 1.5rem 6rem;
      text-align: center;
    }
    .ds-map-wrap {
      max-width: 900px;
      margin: 0 auto;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 30%, transparent);
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    .ds-map-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 1.1rem;
      background: var(--ds-bg-2);
      border-bottom: 1px solid color-mix(in srgb, var(--ds-yellow) 25%, transparent);
      font-size: 0.82rem;
      color: var(--ds-yellow-dim);
    }
    .ds-map-open {
      color: var(--ds-yellow);
      text-decoration: none;
      font-size: 0.78rem;
    }
    .ds-map-open:hover { text-decoration: underline; }
    .ds-map-wrap iframe {
      display: block;
      filter: grayscale(60%) invert(92%) contrast(90%);
    }

    /* ── Fotos parallax entre secciones ── */
    .ds-photo-section {
      position: relative;
      overflow: hidden;
      width: 100%;
    }
    .ds-photo-bg {
      position: absolute;
      inset: -20% 0;
      background-size: cover;
      background-position: center;
      will-change: transform;
    }
    .ds-photo-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        color-mix(in srgb, var(--ds-bg-2) 72%, transparent) 0%,
        color-mix(in srgb, var(--ds-bg) 55%, transparent) 50%,
        color-mix(in srgb, var(--ds-bg-2) 78%, transparent) 100%
      );
    }
    /* Cuando .ds-photo-section se reutiliza sobre una sección con contenido
       real (no solo un divisor decorativo), ese contenido debe quedar por
       encima de las capas absolutas de fondo/overlay. */
    .ds-photo-section > *:not(.ds-photo-bg):not(.ds-photo-overlay) {
      position: relative;
      z-index: 1;
    }

    /* ── Sección Transporte (bus) ── */
    .ds-bus-section {
      background: var(--ds-bg-2);
      padding: 6rem 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .ds-bus-container {
      max-width: 700px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      position: relative;
      z-index: 1;
    }
    .ds-bus-intro {
      font-family: 'Lato', sans-serif;
      font-size: 0.92rem;
      text-align: center;
      line-height: 1.8;
      color: var(--ds-yellow-dim);
      max-width: 480px;
      margin-top: 0.25rem;
    }
    .ds-bus-heading {
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      color: var(--ds-white);
      text-align: center;
      max-width: 520px;
      margin: 2.25rem auto 0.25rem;
      line-height: 1.6;
    }
    .ds-bus-ida-wrap {
      display: flex;
      justify-content: center;
      width: 100%;
      max-width: 420px;
      margin-top: 1.5rem;
    }
    .ds-bus-ida-wrap .ds-bus-card { flex: 1; }
    .ds-bus-routes {
      display: flex;
      align-items: stretch;
      gap: 1.5rem;
      margin: 1rem 0;
      width: 100%;
      max-width: 580px;
      justify-content: center;
    }
    .ds-bus-card {
      flex: 1;
      background: var(--ds-bg);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 30%, transparent);
      border-radius: 6px;
      padding: 1.8rem 1.5rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      transition: border-color 0.25s, transform 0.25s;
    }
    .ds-bus-card:hover { border-color: var(--ds-yellow); transform: translateY(-2px); }
    .ds-bus-direction {
      font-family: 'Lato', sans-serif;
      font-size: 0.58rem;
      letter-spacing: 0.3em;
      color: var(--ds-yellow);
      font-weight: 700;
    }
    .ds-bus-route {
      font-family: 'Lato', sans-serif;
      font-size: 0.85rem;
      color: var(--ds-white);
      line-height: 1.4;
    }
    .ds-bus-time {
      font-family: 'StarJedi', sans-serif;
      font-size: 1.5rem;
      color: var(--ds-yellow);
      margin-top: 0.25rem;
    }
    @media (max-width: 580px) {
      .ds-bus-routes { flex-direction: column; }
    }

    /* ── Sección RSVP ── */
    .ds-rsvp-section {
      background: var(--ds-bg);
      padding: 6rem 1.5rem;
    }
    .ds-rsvp-container {
      max-width: 680px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .ds-rsvp-intro {
      text-align: center;
      color: var(--ds-yellow-dim);
      font-family: 'Lato', sans-serif;
      font-size: 0.92rem;
      line-height: 1.8;
      margin-bottom: 1rem;
    }
    .ds-rsvp-form { width: 100%; display: flex; flex-direction: column; gap: 2rem; }
    .ds-form-group { display: flex; flex-direction: column; gap: 0.6rem; }
    .ds-form-group > label {
      font-family: 'Lato', sans-serif;
      font-size: 0.95rem;
      color: var(--ds-white);
      font-weight: 400;
    }
    .ds-form-hint {
      font-size: 0.82rem;
      color: var(--ds-yellow-dim);
      font-style: italic;
      line-height: 1.6;
    }
    .ds-photo-hint {
      margin-top: 0.8rem;
      padding: 1.8rem 1.5rem;
      background: color-mix(in srgb, var(--ds-yellow) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 25%, transparent);
      border-top: 3px solid var(--ds-yellow);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }
    .ds-photo-hint-icon { width: 44px; height: 44px; filter: invert(1) opacity(0.85); }
    .ds-photo-hint-text {
      font-family: 'Lato', sans-serif;
      font-size: 0.92rem;
      color: var(--ds-yellow-dim);
      line-height: 1.8;
      font-style: italic;
    }
    .ds-photo-hint-contact {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.65rem;
      padding-top: 0.75rem;
      border-top: 1px solid color-mix(in srgb, var(--ds-yellow) 25%, transparent);
      width: 100%;
    }
    .ds-photo-hint-name {
      font-family: 'StarJedi', sans-serif;
      font-size: 0.95rem;
      color: var(--ds-white);
    }
    .ds-photo-hint-tel {
      display: inline-block;
      padding: 0.6rem 1.8rem;
      border: 1px solid var(--ds-yellow);
      color: var(--ds-yellow);
      text-decoration: none;
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      letter-spacing: 0.1em;
      transition: background 0.2s, color 0.2s;
    }
    .ds-photo-hint-tel:hover { background: var(--ds-yellow); color: var(--ds-bg-2); }

    .ds-rsvp-section input[type="text"],
    .ds-rsvp-section input[type="email"],
    .ds-rsvp-section input[type="number"],
    .ds-rsvp-section textarea {
      width: 100%;
      padding: 0.9rem 1rem;
      background: var(--ds-bg-2);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 40%, transparent);
      border-radius: 0;
      font-family: 'Lato', sans-serif;
      font-size: 0.9rem;
      color: var(--ds-white);
      outline: none;
      transition: border-color 0.2s;
      appearance: none;
    }
    .ds-rsvp-section input[type="text"]:focus,
    .ds-rsvp-section textarea:focus { border-color: var(--ds-yellow); }
    .ds-rsvp-section textarea { resize: vertical; }

    .ds-radio-group, .ds-checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ds-radio-option, .ds-checkbox-option {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      cursor: pointer;
      padding: 0.7rem 1rem;
      background: var(--ds-bg-2);
      border: 1px solid color-mix(in srgb, var(--ds-yellow) 22%, transparent);
      transition: border-color 0.2s, background 0.2s;
      font-size: 0.9rem;
      color: var(--ds-white);
    }
    .ds-radio-option:hover, .ds-checkbox-option:hover {
      border-color: var(--ds-yellow);
      background: color-mix(in srgb, var(--ds-yellow) 8%, transparent);
    }
    .ds-radio-option input, .ds-checkbox-option input {
      accent-color: var(--ds-yellow);
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    .ds-conditional { margin-top: 0.5rem; }

    .ds-submit-btn {
      align-self: center;
      padding: 1rem 3rem;
